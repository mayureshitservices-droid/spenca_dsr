<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user, userRole }) %>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <!-- Alerts -->
            <% if (typeof success !=='undefined' && success) { %>
                <div
                    class="mb-8 p-4 bg-emerald-500/10 border-l-4 border-emerald-500 text-emerald-100 flex items-center justify-between gap-3 rounded-r-xl backdrop-blur-md">
                    <div class="flex items-center gap-3">
                        <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500"></i>
                        <p class="font-bold">
                            <%= success %>
                        </p>
                    </div>
                    <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-400">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
                <% } %>

                    <% if (typeof error !=='undefined' && error) { %>
                        <div
                            class="mb-8 p-4 bg-red-500/10 border-l-4 border-red-500 text-red-100 flex items-center justify-between gap-3 rounded-r-xl backdrop-blur-md">
                            <div class="flex items-center gap-3">
                                <i data-lucide="alert-triangle" class="w-5 h-5 text-red-500"></i>
                                <p class="font-bold">
                                    <%= error %>
                                </p>
                            </div>
                            <button onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-400">
                                <i data-lucide="x" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <% } %>

                            <!-- Finished Products Section -->
                            <div class="mb-16 scroll-mt-24" id="finished-products">
                                <div
                                    class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-8">
                                    <div class="flex items-center gap-4">
                                        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Finished Products
                                        </h2>
                                        <span
                                            class="px-4 py-1.5 bg-indigo-100 text-indigo-700 text-xs font-black rounded-full uppercase tracking-widest leading-none">Catalog</span>
                                    </div>
                                    <button onclick="openModal()"
                                        class="inline-flex items-center gap-3 py-3 px-6 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl transition-all transform hover:scale-105 shadow-lg shadow-indigo-600/30">
                                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                                        Add New Product
                                    </button>
                                </div>

                                <% if (finishedGoods.length===0) { %>
                                    <div
                                        class="bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                                        <i data-lucide="package" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Finished Products</h3>
                                        <p class="text-gray-500 font-medium">Add your first product to get started.</p>
                                    </div>
                                    <% } else { %>
                                        <div
                                            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                                            <% finishedGoods.forEach(function(p) { %>
                                                <div
                                                    class="bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg overflow-hidden border border-white/20 transition-all hover:shadow-2xl hover:-translate-y-2 group flex flex-col h-full">
                                                    <div class="relative h-56 overflow-hidden">
                                                        <% if (p.photo) { %>
                                                            <img src="<%= p.photo %>"
                                                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                                                alt="<%= p.productName %>">
                                                            <% } else { %>
                                                                <div
                                                                    class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-300">
                                                                    <i data-lucide="image"
                                                                        class="w-12 h-12 text-gray-300"></i>
                                                                </div>
                                                                <% } %>

                                                                    <!-- BOM Count Badge -->
                                                                    <div
                                                                        class="absolute top-4 right-4 flex flex-col gap-2">
                                                                        <% if (p.components && p.components.length> 0) {
                                                                            %>
                                                                            <div
                                                                                class="px-3 py-1 bg-indigo-600/90 backdrop-blur-md text-white text-[10px] font-black rounded-full shadow-lg flex items-center gap-2 uppercase tracking-widest border border-white/20">
                                                                                <i data-lucide="layers"
                                                                                    class="w-3 h-3"></i>
                                                                                <%= p.components.length %> BOM Items
                                                                            </div>
                                                                            <% } else { %>
                                                                                <div
                                                                                    class="px-3 py-1 bg-gray-800/60 backdrop-blur-md text-white/70 text-[10px] font-black rounded-full shadow-lg flex items-center gap-2 uppercase tracking-widest border border-white/10">
                                                                                    <i data-lucide="layers-2"
                                                                                        class="w-3 h-3"></i>
                                                                                    BOM Empty
                                                                                </div>
                                                                                <% } %>
                                                                    </div>
                                                    </div>

                                                    <div class="p-6 flex flex-col flex-grow">
                                                        <h5
                                                            class="text-xl font-black text-gray-900 mb-2 leading-tight tracking-tight">
                                                            <%= p.productName %>
                                                        </h5>
                                                        <% if (p.packaging) { %>
                                                            <div
                                                                class="flex items-center gap-2 text-sm font-bold text-gray-500 mb-2">
                                                                <i data-lucide="package"
                                                                    class="w-4 h-4 text-indigo-500"></i>
                                                                <%= p.packaging %>
                                                            </div>
                                                            <% } %>

                                                                <div class="mb-4 space-y-2">
                                                                    <div
                                                                        class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1 pl-1">
                                                                        Required Materials (BOM)</div>
                                                                    <div
                                                                        class="bg-gray-50/50 rounded-2xl border border-gray-100 divide-y divide-gray-100 overflow-hidden">
                                                                        <% if (p.components && p.components.length> 0) {
                                                                            %>
                                                                            <% p.components.slice(0,
                                                                                4).forEach(function(comp) { %>
                                                                                <div
                                                                                    class="flex items-center justify-between p-2.5">
                                                                                    <div
                                                                                        class="flex items-center gap-2">
                                                                                        <div
                                                                                            class="w-2 h-2 rounded-full bg-indigo-400">
                                                                                        </div>
                                                                                        <span
                                                                                            class="text-xs font-bold text-gray-700 line-clamp-1">
                                                                                            <%= comp.productName %>
                                                                                        </span>
                                                                                    </div>
                                                                                    <div
                                                                                        class="flex items-baseline gap-1">
                                                                                        <span
                                                                                            class="text-xs font-black text-indigo-600">
                                                                                            <%= comp.quantity %>
                                                                                        </span>
                                                                                        <span
                                                                                            class="text-[9px] font-bold text-gray-400 uppercase">
                                                                                            <%= comp.uom %>
                                                                                        </span>
                                                                                    </div>
                                                                                </div>
                                                                                <% }); %>
                                                                                    <% if (p.components.length> 4) { %>
                                                                                        <div
                                                                                            class="p-2 text-center text-[9px] font-black text-gray-400 uppercase tracking-widest bg-gray-50/30">
                                                                                            + <%= p.components.length -
                                                                                                4 %> More Materials
                                                                                        </div>
                                                                                        <% } %>
                                                                                            <% } else { %>
                                                                                                <div
                                                                                                    class="p-6 text-center">
                                                                                                    <i data-lucide="info"
                                                                                                        class="w-5 h-5 text-gray-300 mx-auto mb-1 opacity-50"></i>
                                                                                                    <p
                                                                                                        class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                                                                                                        No BOM Assigned
                                                                                                    </p>
                                                                                                </div>
                                                                                                <% } %>
                                                                    </div>
                                                                </div>

                                                                <% if (p.remarks) { %>
                                                                    <p
                                                                        class="text-xs font-medium text-gray-400 mb-6 italic line-clamp-1">
                                                                        "<%= p.remarks %>"</p>
                                                                    <% } %>

                                                                        <div
                                                                            class="mt-auto pt-6 border-t border-gray-100 flex items-center justify-between">
                                                                            <button
                                                                                onclick="deleteProduct('<%= p._id %>')"
                                                                                class="inline-flex items-center gap-2 text-sm font-black text-red-500 hover:text-red-700 transition-colors uppercase tracking-widest px-2 py-1 hover:bg-red-50 rounded-lg">
                                                                                <i data-lucide="trash-2"
                                                                                    class="w-4 h-4"></i>
                                                                                Delete
                                                                            </button>
                                                                            <button
                                                                                onclick="openEditBOM('<%= p._id %>')"
                                                                                class="inline-flex items-center gap-2 text-sm font-black text-indigo-600 hover:text-indigo-800 transition-colors uppercase tracking-widest px-2 py-1 hover:bg-indigo-50 rounded-lg">
                                                                                <i data-lucide="settings"
                                                                                    class="w-4 h-4"></i>
                                                                                Edit BOM
                                                                            </button>
                                                                        </div>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                        <% } %>
                            </div>

                            <!-- Raw Materials / BOM Items Section -->
                            <div class="mb-16 scroll-mt-24" id="raw-materials">
                                <div
                                    class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-8">
                                    <div class="flex items-center gap-4">
                                        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Raw Materials</h2>
                                        <span
                                            class="px-4 py-1.5 bg-emerald-100 text-emerald-700 text-xs font-black rounded-full uppercase tracking-widest leading-none">BOM
                                            Items</span>
                                    </div>
                                    <button onclick="openAddBOMModal('Raw Material')"
                                        class="inline-flex items-center gap-3 py-3 px-6 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-2xl transition-all transform hover:scale-105 shadow-lg shadow-emerald-600/30">
                                        <i data-lucide="plus" class="w-5 h-5"></i>
                                        Add BOM Item
                                    </button>
                                </div>

                                <% if (rawMaterials.length===0) { %>
                                    <div
                                        class="bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                                        <i data-lucide="component" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Raw Materials Added</h3>
                                        <p class="text-gray-500 font-medium">Add materials like Caps, Bottles, Labels,
                                            etc.</p>
                                    </div>
                                    <% } else { %>
                                        <div
                                            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                                            <% rawMaterials.forEach(function(p) { %>
                                                <div
                                                    class="bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg overflow-hidden border border-white/20 transition-all hover:shadow-2xl hover:-translate-y-2 group flex flex-col h-full border-t-4 border-t-emerald-500">
                                                    <div class="p-6 flex flex-col flex-grow">
                                                        <div class="flex justify-between items-start mb-4">
                                                            <h5
                                                                class="text-xl font-black text-gray-900 leading-tight tracking-tight">
                                                                <%= p.productName %>
                                                            </h5>
                                                            <span
                                                                class="text-[10px] font-black px-2 py-1 bg-emerald-50 text-emerald-600 rounded-lg uppercase">Material</span>
                                                        </div>

                                                        <% if (p.specification) { %>
                                                            <div
                                                                class="text-xs font-bold text-gray-400 mb-4 uppercase tracking-widest">
                                                                <%= p.specification %>
                                                            </div>
                                                            <% } %>

                                                                <div class="grid grid-cols-2 gap-3 mb-6">
                                                                    <div
                                                                        class="bg-emerald-50/30 rounded-xl p-3 border border-emerald-100/50">
                                                                        <div
                                                                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">
                                                                            Stock</div>
                                                                        <div class="flex items-baseline gap-1">
                                                                            <span
                                                                                class="text-lg font-black <%= (p.availableQty || 0) <= (p.bufferQty || 0) ? 'text-red-500' : 'text-emerald-600' %> tracking-tighter">
                                                                                <%= p.availableQty || 0 %>
                                                                            </span>
                                                                            <span
                                                                                class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">
                                                                                <%= p.uom || 'Unit' %>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                    <div
                                                                        class="bg-emerald-50/30 rounded-xl p-3 border border-emerald-100/50">
                                                                        <div
                                                                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">
                                                                            Buffer</div>
                                                                        <div
                                                                            class="text-lg font-black text-gray-900 tracking-tighter">
                                                                            <%= p.bufferQty || 0 %>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div
                                                                    class="mt-auto pt-6 border-t border-gray-100 flex items-center justify-between">
                                                                    <button onclick="deleteProduct('<%= p._id %>')"
                                                                        class="inline-flex items-center gap-2 text-sm font-black text-red-500 hover:text-red-700 transition-colors uppercase tracking-widest px-2 py-1 hover:bg-red-50 rounded-lg">
                                                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                                        Delete
                                                                    </button>
                                                                </div>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                        <% } %>
                            </div>
        </div>

        <!-- Create Product Modal (Main) -->
        <div id="createProductModal" class="fixed inset-0 z-[2000] hidden items-center justify-center p-4">
            <div onclick="closeModal()" class="absolute inset-0 bg-gray-900/80 backdrop-blur-md"></div>
            <div
                class="relative w-full max-w-2xl bg-white rounded-3xl shadow-around-lg overflow-hidden transform transition-all animate-in fade-in zoom-in duration-300 max-h-[90vh] flex flex-col">
                <div class="p-8 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                    <div>
                        <h3 class="text-2xl font-black text-gray-900 tracking-tight">Catalog New Item</h3>
                        <p class="text-sm font-bold text-gray-500 mt-1 uppercase tracking-widest">General Product
                            Details</p>
                    </div>
                    <button onclick="closeModal()"
                        class="p-2 hover:bg-white rounded-xl transition-colors text-gray-400 hover:text-gray-900 shadow-sm hover:shadow-md">
                        <i data-lucide="x" class="w-6 h-6"></i>
                    </button>
                </div>

                <div class="overflow-y-auto flex-grow">
                    <form action="/sysadmin/products/create" method="POST" enctype="multipart/form-data"
                        class="p-8 space-y-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="col-span-1 md:col-span-2 space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none">Product
                                    Name / Item Name</label>
                                <input type="text" name="productName" required
                                    class="input-field !py-4 !text-lg !font-black" placeholder="Enter product name...">
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Specification</label>
                                <input type="text" name="specification" class="input-field"
                                    placeholder="e.g. 100% Organic, UV Treated">
                            </div>

                            <div class="space-y-2">
                                <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Unit
                                    of Measure (UOM)</label>
                                <select name="uom" class="input-field">
                                    <option value="Pcs">Pcs</option>
                                    <option value="Kg">Kg</option>
                                    <option value="Ltrs">Ltrs</option>
                                    <option value="Meters">Meters</option>
                                    <option value="Rolls">Rolls</option>
                                    <option value="Packets">Packets</option>
                                </select>
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Available
                                    Qty</label>
                                <input type="number" step="0.01" name="availableQty" class="input-field"
                                    placeholder="0.00">
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Buffer
                                    Quantity</label>
                                <input type="number" step="0.01" name="bufferQty" class="input-field"
                                    placeholder="0.00">
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Packaging
                                    Details</label>
                                <input type="text" name="packaging" class="input-field"
                                    placeholder="e.g. 12 bottles per case">
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Visual
                                    Identity (Photo)</label>
                                <input type="file" name="photo" accept="image/*"
                                    class="w-full px-5 py-2.5 bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl font-bold text-gray-500 file:mr-4 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-[10px] file:font-black file:bg-indigo-50 file:text-indigo-700">
                            </div>

                            <div class="col-span-1 md:col-span-2 space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Additional
                                    Remarks</label>
                                <textarea name="remarks" rows="2" class="input-field"
                                    placeholder="Internal notes..."></textarea>
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100">
                            <input type="hidden" name="productType" value="Finished Good">
                            <button type="button" onclick="closeModal()"
                                class="px-8 py-4 text-gray-500 font-bold hover:text-gray-900 transition-colors">Discard</button>
                            <button type="submit"
                                class="px-10 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl shadow-xl shadow-indigo-600/20 transition-all transform active:scale-95 leading-none">
                                Save Product
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Add BOM Item Modal (For Raw Materials) -->
        <div id="addBOMItemModal" class="fixed inset-0 z-[2000] hidden items-center justify-center p-4">
            <div onclick="closeAddBOMModal()" class="absolute inset-0 bg-gray-900/80 backdrop-blur-md"></div>
            <div
                class="relative w-full max-w-2xl bg-white rounded-3xl shadow-around-lg overflow-hidden transform transition-all animate-in fade-in zoom-in duration-300 max-h-[90vh] flex flex-col border-t-8 border-emerald-500">
                <div class="p-8 border-b border-gray-100 flex items-center justify-between bg-emerald-50/30">
                    <div>
                        <h3 class="text-2xl font-black text-gray-900 tracking-tight">Add Raw Material</h3>
                        <p class="text-sm font-bold text-emerald-600 mt-1 uppercase tracking-widest">Cap, Label,
                            Preform, etc.</p>
                    </div>
                    <button onclick="closeAddBOMModal()"
                        class="p-2 hover:bg-white rounded-xl transition-colors text-gray-400 hover:text-gray-900 shadow-sm hover:shadow-md">
                        <i data-lucide="x" class="w-6 h-6"></i>
                    </button>
                </div>

                <div class="overflow-y-auto flex-grow">
                    <form action="/sysadmin/products/create" method="POST" enctype="multipart/form-data"
                        class="p-8 space-y-8">
                        <input type="hidden" name="productType" value="Raw Material">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="col-span-1 md:col-span-2 space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none">Material
                                    Name</label>
                                <input type="text" name="productName" required
                                    class="input-field !py-4 !text-lg !font-black" placeholder="e.g. Blue Cap CTC 28mm">
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Specification</label>
                                <input type="text" name="specification" class="input-field"
                                    placeholder="e.g. UV Treated, Food Grade">
                            </div>

                            <div class="space-y-2">
                                <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Unit
                                    of Measure</label>
                                <select name="uom" class="input-field">
                                    <option value="Pcs">Pcs</option>
                                    <option value="Kg">Kg</option>
                                    <option value="Ltrs">Ltrs</option>
                                    <option value="Rolls">Rolls</option>
                                    <option value="Packets">Packets</option>
                                </select>
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Initial
                                    Stock</label>
                                <input type="number" step="0.01" name="availableQty" class="input-field" value="0.00">
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Buffer
                                    Stock</label>
                                <input type="number" step="0.01" name="bufferQty" class="input-field" value="0.00">
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100">
                            <button type="button" onclick="closeAddBOMModal()"
                                class="px-8 py-4 text-gray-500 font-bold hover:text-gray-900 transition-colors">Discard</button>
                            <button type="submit"
                                class="px-10 py-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-2xl shadow-xl shadow-emerald-600/20 transition-all transform active:scale-95 leading-none">
                                Save Material
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Edit BOM Modal -->
        <div id="editBOMModal" class="fixed inset-0 z-[2000] hidden items-center justify-center p-4">
            <div onclick="closeEditBOM()" class="absolute inset-0 bg-gray-900/80 backdrop-blur-md"></div>
            <div
                class="relative w-full max-w-3xl bg-white rounded-3xl shadow-around-lg overflow-hidden transform transition-all animate-in fade-in zoom-in duration-300 max-h-[90vh] flex flex-col">
                <div class="p-8 border-b border-gray-100 flex items-center justify-between bg-indigo-50/50">
                    <div>
                        <h3 class="text-2xl font-black text-gray-900 tracking-tight" id="bomModalTitle">Edit Bill of
                            Materials</h3>
                        <p class="text-sm font-bold text-indigo-600 mt-1 uppercase tracking-widest">Recipe for Finished
                            Product</p>
                    </div>
                    <button onclick="closeEditBOM()"
                        class="p-2 hover:bg-white rounded-xl transition-colors text-gray-400 hover:text-gray-900 shadow-sm hover:shadow-md">
                        <i data-lucide="x" class="w-6 h-6"></i>
                    </button>
                </div>

                <div class="overflow-y-auto flex-grow p-8">
                    <div id="bomComponentsContainer" class="space-y-4 mb-8">
                        <!-- Component rows will be injected here -->
                    </div>

                    <div class="p-6 bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
                        <div class="flex flex-col sm:flex-row gap-4 items-end">
                            <div class="flex-grow space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Select
                                    Raw Material</label>
                                <select id="newComponentSelect" class="input-field">
                                    <option value="">-- Choose Material --</option>
                                    <% rawMaterials.forEach(function(m) { %>
                                        <option value="<%= m._id %>" data-name="<%= m.productName %>"
                                            data-uom="<%= m.uom %>">
                                            <%= m.productName %> (<%= m.uom %>)
                                        </option>
                                        <% }); %>
                                </select>
                            </div>
                            <div class="w-full sm:w-32 space-y-2">
                                <label
                                    class="block text-[10px] font-black text-gray-400 uppercase tracking-widest">Quantity</label>
                                <input type="number" id="newComponentQty" step="0.001" class="input-field"
                                    placeholder="0.00">
                            </div>
                            <button onclick="addComponentRow()"
                                class="px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-indigo-600/20 transition-all transform active:scale-95 whitespace-nowrap">
                                <i data-lucide="plus" class="w-4 h-4 inline mr-2"></i> Add
                            </button>
                        </div>
                    </div>
                </div>

                <div class="p-8 border-t border-gray-100 flex items-center justify-end gap-4">
                    <button onclick="closeEditBOM()"
                        class="px-8 py-4 text-gray-500 font-bold hover:text-gray-900 transition-colors">Cancel</button>
                    <button onclick="saveBOM()"
                        class="px-10 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl shadow-xl shadow-indigo-600/20 transition-all transform active:scale-95 leading-none">
                        Save BOM
                    </button>
                </div>
            </div>
        </div>

        <%- include('../partials/fab', { user, userRole, hideDefaults: true, extraFabItems: [ { label: 'Finished Goods'
            , icon: 'package-check' , onClick: "showProductSection('finished-products')" }, { label: 'Raw Materials' ,
            icon: 'component' , onClick: "showProductSection('raw-materials')" }, { label: 'Dashboard' ,
            icon: 'layout-dashboard' , onClick: "window.location.href='/sysadmin/dashboard'" } ] }) %>
            <%- include('../partials/footer') %>

                <script>
                    let currentEditingProductId = null;
                    let bomComponents = [];

                    function openModal() {
                        const modal = document.getElementById('createProductModal');
                        if (modal) {
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                            document.body.style.overflow = 'hidden';
                        }
                    }

                    function showProductSection(type) {
                        const sections = ['finished-products', 'raw-materials'];

                        // Close FAB menu first
                        const fabBackdrop = document.getElementById('fabBackdrop');
                        if (fabBackdrop && !fabBackdrop.classList.contains('invisible')) {
                            fabBackdrop.click();
                        }

                        if (type === 'all') {
                            sections.forEach(id => {
                                const el = document.getElementById(id);
                                if (el) el.classList.remove('hidden');
                            });
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        } else {
                            sections.forEach(id => {
                                const el = document.getElementById(id);
                                if (el) {
                                    if (id === type) {
                                        el.classList.remove('hidden');
                                        // Use a slight timeout to ensure visibility before scrolling
                                        setTimeout(() => {
                                            el.scrollIntoView({ behavior: 'smooth' });
                                        }, 50);
                                    } else {
                                        el.classList.add('hidden');
                                    }
                                }
                            });
                        }
                    }

                    function closeModal() {
                        const modal = document.getElementById('createProductModal');
                        modal.classList.remove('flex');
                        modal.classList.add('hidden');
                        document.body.style.overflow = '';
                    }

                    function openAddBOMModal() {
                        const modal = document.getElementById('addBOMItemModal');
                        if (modal) {
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                            document.body.style.overflow = 'hidden';
                        }
                    }

                    function closeAddBOMModal() {
                        const modal = document.getElementById('addBOMItemModal');
                        if (modal) {
                            modal.classList.remove('flex');
                            modal.classList.add('hidden');
                            document.body.style.overflow = '';
                        }
                    }

                    async function openEditBOM(productId) {
                        currentEditingProductId = productId;
                        const modal = document.getElementById('editBOMModal');

                        try {
                            const response = await fetch(`/sysadmin/products/${productId}`);
                            const product = await response.json();

                            document.getElementById('bomModalTitle').textContent = `BOM: ${product.productName}`;
                            bomComponents = product.components || [];
                            renderBOMRows();

                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                            document.body.style.overflow = 'hidden';
                        } catch (error) {
                            console.error('Error fetching product:', error);
                            alert('Failed to load product BOM');
                        }
                    }

                    function closeEditBOM() {
                        const modal = document.getElementById('editBOMModal');
                        modal.classList.remove('flex');
                        modal.classList.add('hidden');
                        document.body.style.overflow = '';
                        currentEditingProductId = null;
                        bomComponents = [];
                    }

                    function renderBOMRows() {
                        const container = document.getElementById('bomComponentsContainer');
                        if (bomComponents.length === 0) {
                            container.innerHTML = `
                                <div class="text-center py-8 text-gray-400">
                                    <i data-lucide="info" class="w-8 h-8 mx-auto mb-2 opacity-20"></i>
                                    <p class="font-bold uppercase tracking-widest text-[10px]">No materials defined</p>
                                </div>
                            `;
                            lucide.createIcons();
                            return;
                        }

                        container.innerHTML = bomComponents.map((comp, index) => `
                            <div class="flex items-center justify-between p-4 bg-white border border-gray-100 rounded-2xl shadow-sm group">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600">
                                        <i data-lucide="component" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <div class="font-black text-gray-900">${comp.productName}</div>
                                        <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Per Unit Requirement</div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4">
                                    <div class="flex items-baseline gap-1 bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100">
                                        <span class="font-black text-indigo-600">${comp.quantity}</span>
                                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">${comp.uom}</span>
                                    </div>
                                    <button onclick="removeComponentRow(${index})" class="p-2 text-red-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all opacity-0 group-hover:opacity-100">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </div>
                        `).join('');
                        lucide.createIcons();
                    }

                    document.addEventListener('DOMContentLoaded', function () {
                        lucide.createIcons();

                        // Default to showing only Finished Products on load
                        showProductSection('finished-products');
                    });

                    function addComponentRow() {
                        const select = document.getElementById('newComponentSelect');
                        const qtyInput = document.getElementById('newComponentQty');

                        const productId = select.value;
                        const quantity = parseFloat(qtyInput.value);

                        if (!productId || isNaN(quantity) || quantity <= 0) {
                            alert('Please select a material and enter a valid quantity');
                            return;
                        }

                        const option = select.options[select.selectedIndex];
                        const productName = option.dataset.name;
                        const uom = option.dataset.uom;

                        // Check if already exists
                        const existing = bomComponents.find(c => c.productId === productId);
                        if (existing) {
                            existing.quantity += quantity;
                        } else {
                            bomComponents.push({ productId, productName, quantity, uom });
                        }

                        // Reset inputs
                        select.value = '';
                        qtyInput.value = '';
                        renderBOMRows();
                    }

                    function removeComponentRow(index) {
                        bomComponents.splice(index, 1);
                        renderBOMRows();
                    }

                    async function saveBOM() {
                        if (!currentEditingProductId) return;

                        try {
                            const response = await fetch(`/sysadmin/products/${currentEditingProductId}/bom`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ components: bomComponents })
                            });

                            if (response.ok) {
                                alert('BOM updated successfully!');
                                closeEditBOM();
                                location.reload();
                            } else {
                                alert('Failed to save BOM');
                            }
                        } catch (error) {
                            console.error('Save BOM error:', error);
                            alert('An error occurred while saving');
                        }
                    }

                    function deleteProduct(productId) {
                        if (!confirm('Are you sure you want to delete this product?')) return;

                        fetch(`/sysadmin/products/${productId}`, {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    location.reload();
                                } else {
                                    alert('Failed to delete product');
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                alert('An error occurred');
                            });
                    }
                </script>