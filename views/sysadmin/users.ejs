<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user, userRole }) %>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-12">
                <button onclick="openModal()" class="btn-primary">
                    <i data-lucide="plus-circle" class="w-5 h-5"></i>
                    Create New User
                </button>
            </div>


            <!-- Users Table Card -->
            <div class="glass-card overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-primary-400 text-black">
                                <th class="px-8 py-5 text-sm font-black uppercase tracking-wider">User
                                    Profile</th>
                                <th class="px-6 py-5 text-sm font-black uppercase tracking-wider">
                                    Organizational Info</th>
                                <th class="px-6 py-5 text-sm font-black uppercase tracking-wider text-center">
                                    Security Status</th>
                                <th class="px-6 py-5 text-sm font-black uppercase tracking-wider">Join
                                    Date</th>
                                <th class="px-8 py-5 text-sm font-black uppercase tracking-wider text-right">
                                    Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <% users.forEach(function(u) { %>
                                <tr class="hover:bg-gray-50/50 transition-colors group">
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-black text-xl">
                                                <%= u.fullName.charAt(0) %>
                                            </div>
                                            <div>
                                                <div class="text-lg font-bold text-gray-900 leading-tight">
                                                    <%= u.fullName %>
                                                </div>
                                                <div class="text-sm font-medium text-gray-400">
                                                    <%= u.email %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-6">
                                        <div class="space-y-1">
                                            <div
                                                class="inline-flex items-center px-3 py-1 bg-gray-100 text-gray-700 text-xs font-black uppercase tracking-widest rounded-lg">
                                                <%= u.role.replace('_', ' ' ) %>
                                            </div>
                                            <div class="text-sm font-bold text-gray-500 flex items-center gap-2">
                                                <i data-lucide="map-pin" class="w-3 h-3 text-black"></i>
                                                <%= u.region %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-6 text-center">
                                        <% if (u.activeStatus) { %>
                                            <span
                                                class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-emerald-100 text-emerald-700 text-xs font-black uppercase tracking-widest rounded-full">
                                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                                Active
                                            </span>
                                            <% } else { %>
                                                <span
                                                    class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-red-100 text-red-700 text-xs font-black uppercase tracking-widest rounded-full">
                                                    <span class="w-2 h-2 rounded-full bg-red-500"></span>
                                                    Inactive
                                                </span>
                                                <% } %>
                                    </td>
                                    <td class="px-6 py-6 font-bold text-gray-400 tabular-nums">
                                        <%= new Date(u.createdAt).toLocaleDateString('en-IN', { day: '2-digit' ,
                                            month: 'short' , year: 'numeric' }) %>
                                    </td>
                                    <td class="px-8 py-6 text-right">
                                        <button onclick="toggleStatus('<%= u._id %>')"
                                            class="p-3 rounded-2xl <%= u.activeStatus ? 'text-red-500 hover:bg-red-50' : 'text-emerald-500 hover:bg-emerald-50' %> transition-all border border-transparent hover:border-current transform active:scale-90">
                                            <i data-lucide="<%= u.activeStatus ? 'user-minus' : 'user-check' %>"
                                                class="w-6 h-6"></i>
                                        </button>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="createUserModal" class="fixed inset-0 z-[2000] hidden items-center justify-center p-4">
            <div onclick="closeModal()" class="absolute inset-0 bg-gray-900/80 backdrop-blur-md"></div>
            <div
                class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl overflow-hidden transform transition-all animate-in fade-in zoom-in duration-300 max-h-[90vh] flex flex-col">
                <div class="bg-primary-600 px-6 sm:px-8 py-5 sm:py-6 flex items-center justify-between shrink-0">
                    <h2 class="text-xl sm:text-2xl font-black text-black flex items-center gap-3 tracking-tight">
                        <i data-lucide="user-plus" class="w-6 h-6 sm:w-8 sm:h-8"></i>
                        Register New User
                    </h2>
                    <button onclick="closeModal()" class="text-black/60 hover:text-black transition-colors">
                        <i data-lucide="x" class="w-6 h-6"></i>
                    </button>
                </div>

                <div class="overflow-y-auto">
                    <form action="/sysadmin/users/create" method="POST" class="p-6 sm:p-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                            <div class="space-y-2">
                                <label class="block text-xs font-black text-gray-500 uppercase tracking-widest">Full
                                    Identity Name</label>
                                <input type="text" name="fullName" required class="input-field"
                                    placeholder="Johnathan Doe">
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="block text-xs font-black text-gray-500 uppercase tracking-widest">Operational
                                    Region</label>
                                <input type="text" name="region" required class="input-field" placeholder="North India">
                            </div>
                            <div class="space-y-2">
                                <label class="block text-xs font-black text-gray-500 uppercase tracking-widest">Contact
                                    Frequency</label>
                                <input type="tel" name="contactNo" required class="input-field"
                                    placeholder="+91 9876543210">
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="block text-xs font-black text-gray-500 uppercase tracking-widest">Enterprise
                                    Email</label>
                                <input type="email" name="email" required class="input-field"
                                    placeholder="j.doe@company.com">
                            </div>
                            <div class="space-y-2">
                                <label class="block text-xs font-black text-gray-500 uppercase tracking-widest">Access
                                    Key
                                    (Password)</label>
                                <input type="password" name="password" minlength="6" required class="input-field"
                                    placeholder="••••••••">
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="block text-xs font-black text-gray-500 uppercase tracking-widest">Organizational
                                    Role</label>
                                <select name="role" required class="input-field">
                                    <option value="">Choose Privilege Level</option>
                                    <option value="sysadmin">System Admin (Full Access)</option>
                                    <option value="owner">Owner (Report Access)</option>
                                    <option value="headoffice">Head Office (View & Export)</option>
                                    <option value="salesperson">Salesperson (Order Access)</option>
                                    <option value="factory_incharge">Factory Incharge (Stock Access)</option>
                                </select>
                            </div>
                            <div class="space-y-2" id="factoryField" style="display: none;">
                                <label
                                    class="block text-xs font-black text-gray-500 uppercase tracking-widest">Assigned
                                    Factory</label>
                                <select name="factory" class="input-field">
                                    <option value="">Choose Factory Location</option>
                                    <option value="indapur">Indapur</option>
                                    <option value="shirapur">Shirapur</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-4 border-t border-gray-100 pt-8">
                            <button type="button" onclick="closeModal()"
                                class="px-8 py-4 text-gray-500 font-bold hover:text-gray-900 transition-colors">Cancel</button>
                            <button type="submit" class="btn-primary">
                                Confirm & Provision User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/fab', { user, userRole }) %>

            <!-- Alerts (Relocated to bottom) -->
            <div class="max-w-4xl mx-auto px-4 pb-10 space-y-4">
                <% if (typeof success !=='undefined' && success) { %>
                    <div
                        class="p-4 bg-emerald-500/10 border-l-4 border-emerald-500 text-emerald-800 flex items-center justify-between gap-3 rounded-r-xl backdrop-blur-md animate-in fade-in slide-in-from-bottom-4 duration-500">
                        <div class="flex items-center gap-3">
                            <i data-lucide="check-circle-2" class="w-6 h-6 text-emerald-500"></i>
                            <p class="font-bold">
                                <%= success %>
                            </p>
                        </div>
                    </div>
                    <% } %>

                        <% if (typeof error !=='undefined' && error) { %>
                            <div
                                class="p-6 bg-red-100 border-l-8 border-red-600 text-red-900 rounded-xl shadow-md animate-in fade-in slide-in-from-bottom-4 duration-500">
                                <div class="flex items-start gap-4">
                                    <i data-lucide="alert-octagon" class="w-8 h-8 text-red-600 shrink-0"></i>
                                    <div class="space-y-1">
                                        <p class="text-sm font-black uppercase tracking-widest text-red-600">Requirement
                                            Not Met</p>
                                        <p class="font-bold text-lg leading-tight">
                                            <%= error %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <% } %>

                                <!-- Client-side Error Box -->
                                <div id="clientErrorBox"
                                    class="hidden p-6 bg-red-100 border-l-8 border-red-600 text-red-900 rounded-xl shadow-md animate-in fade-in slide-in-from-bottom-4 duration-300">
                                    <div class="flex items-start gap-4">
                                        <i data-lucide="alert-circle" class="w-8 h-8 text-red-600 shrink-0"></i>
                                        <div class="space-y-1">
                                            <p class="text-sm font-black uppercase tracking-widest text-red-600">Check
                                                Input Details</p>
                                            <p id="clientErrorText" class="font-bold text-lg leading-tight"></p>
                                        </div>
                                        <button type="button"
                                            onclick="document.getElementById('clientErrorBox').classList.add('hidden')"
                                            class="ml-auto text-red-400 hover:text-red-600">
                                            <i data-lucide="x" class="w-5 h-5"></i>
                                        </button>
                                    </div>
                                </div>
            </div>

            <%- include('../partials/footer') %>

                <script>
                    function showClientError(msg) {
                        const errorBox = document.getElementById('clientErrorBox');
                        const errorText = document.getElementById('clientErrorText');
                        if (errorBox && errorText) {
                            errorText.textContent = msg;
                            errorBox.classList.remove('hidden');
                            if (typeof lucide !== 'undefined') lucide.createIcons();
                            errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        } else {
                            alert(msg);
                        }
                    }

                    function openModal() {
                        const modal = document.getElementById('createUserModal');
                        modal.classList.remove('hidden');
                        modal.classList.add('flex');
                        document.body.style.overflow = 'hidden';
                    }

                    function closeModal() {
                        const modal = document.getElementById('createUserModal');
                        modal.classList.remove('flex');
                        modal.classList.add('hidden');
                        document.body.style.overflow = '';
                    }

                    // Show/Hide Factory Field based on Role
                    document.querySelector('select[name="role"]').addEventListener('change', function () {
                        const factoryField = document.getElementById('factoryField');
                        if (this.value === 'factory_incharge') {
                            factoryField.style.display = 'block';
                            factoryField.querySelector('select').setAttribute('required', 'required');
                        } else {
                            factoryField.style.display = 'none';
                            factoryField.querySelector('select').removeAttribute('required');
                        }
                    });

                    function toggleStatus(userId) {
                        if (false) return; // Removed confirmation as per user request

                        // Reset client error box
                        const errorBox = document.getElementById('clientErrorBox');
                        if (errorBox) errorBox.classList.add('hidden');

                        fetch(`/sysadmin/users/${userId}/toggle-status`, {
                            method: 'PATCH',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    location.reload();
                                } else {
                                    showClientError('Failed to toggle status. Please try again.');
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                showClientError('An unexpected error occurred while updating status.');
                            });
                    }
                </script>