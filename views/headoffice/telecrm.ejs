<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user, userRole }) %>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

            <!-- Device List View -->
            <div id="deviceList">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-black flex items-center gap-3">
                        <i data-lucide="smartphone" class="w-6 h-6 text-black"></i>
                        TeleCRM Devices
                    </h2>
                </div>

                <% if (devices.length===0) { %>
                    <div class="glass-card p-12 text-center border border-dashed border-gray-300">
                        <i data-lucide="smartphone" class="w-12 h-12 text-gray-300 mb-4 block mx-auto"></i>
                        <p class="text-gray-500 text-lg font-medium">No devices connected yet.</p>
                    </div>
                    <% } else { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% devices.forEach(function(device) { %>
                                <div onclick="showDeviceDetails('<%= device.id %>')"
                                    class="glass-card p-5 group transition-all hover:shadow-2xl cursor-pointer hover:-translate-y-1">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="flex items-center gap-2">
                                            <div
                                                class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-black text-lg">
                                                <i data-lucide="smartphone" class="w-5 h-5"></i>
                                            </div>
                                            <div>
                                                <h4 class="text-[8px] font-black text-gray-900 leading-tight">
                                                    <%= device.name %>
                                                </h4>
                                                <p class="text-[8px] font-bold text-gray-400 uppercase tracking-widest">
                                                    <%= device.id %>
                                                </p>
                                            </div>
                                        </div>
                                        <span
                                            class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-widest <%= device.status === 'online' ? 'bg-emerald-100 text-emerald-700' : 'bg-gray-100 text-gray-500' %>">
                                            <%= device.status %>
                                        </span>
                                    </div>

                                    <!-- Inline Telecaller Edit -->
                                    <div class="mb-4 bg-gray-50 p-3 rounded-xl border border-gray-100"
                                        onclick="event.stopPropagation()">
                                        <div class="flex items-center justify-between gap-2">
                                            <div class="flex items-center gap-2 flex-1">
                                                <i data-lucide="user" class="w-4 h-4 text-gray-400"></i>
                                                <input type="text" id="cardTelecaller_<%= device.id %>"
                                                    value="<%= device.telecaller %>"
                                                    class="bg-transparent border-none p-0 text-sm font-bold text-gray-900 focus:ring-0 w-full"
                                                    onkeypress="if(event.key === 'Enter') saveCardTelecaller('<%= device.id %>')">
                                            </div>
                                            <button onclick="saveCardTelecaller('<%= device.id %>')"
                                                id="saveBtn_<%= device.id %>"
                                                class="p-1.5 bg-white hover:bg-primary-50 text-gray-400 hover:text-primary-600 rounded-lg shadow-sm border border-gray-100 transition-all opacity-0 group-hover:opacity-100 focus:opacity-100">
                                                <i data-lucide="save" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="space-y-2">
                                        <!-- For the Day -->
                                        <div>
                                            <div class="flex items-center gap-2 mb-1.5 text-[10px]">
                                                <i data-lucide="calendar" class="w-3.5 h-3.5 text-gray-400"></i>
                                                <span
                                                    class="text-[10px] font-black text-gray-400 capitalize tracking-widest leading-none">For
                                                    the day</span>
                                                <div class="flex-1 h-[0.5px] bg-gray-200"></div>
                                            </div>
                                            <div
                                                class="flex rounded-lg overflow-hidden border border-gray-200 shadow-md">
                                                <div
                                                    class="flex-1 bg-indigo-50 py-2 text-center border-b-[3px] border-indigo-200 border-r border-gray-300">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">
                                                        Total</p>
                                                    <p
                                                        class="text-[11px] text-black leading-none font-mono tracking-tighter">
                                                        <%= device.callStats.today.total %>
                                                    </p>
                                                </div>
                                                <div
                                                    class="flex-1 bg-emerald-50 py-2 text-center border-b-[3px] border-emerald-200 border-r border-gray-300 last:border-r-0">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">Ans
                                                    </p>
                                                    <p
                                                        class="text-[11px] text-black leading-none font-mono tracking-tighter">
                                                        <%= device.callStats.today.answered %>
                                                    </p>
                                                </div>
                                                <div
                                                    class="flex-1 bg-red-50 py-2 text-center border-b-[3px] border-red-200 border-r border-gray-300 last:border-r-0">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">Miss
                                                    </p>
                                                    <p
                                                        class="text-[11px] text-black leading-none font-mono tracking-tighter">
                                                        <%= device.callStats.today.missed %>
                                                    </p>
                                                </div>
                                                <div
                                                    class="flex-1 bg-purple-50 py-2 text-center border-b-[3px] border-purple-200 border-r border-gray-300 last:border-r-0">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">Dur
                                                    </p>
                                                    <p
                                                        class="text-[11px] text-black leading-none truncate px-0.5 font-mono tracking-tighter">
                                                        <%= device.callStats.today.duration %>
                                                    </p>
                                                </div>
                                                <div
                                                    class="flex-1 bg-blue-50 py-2 text-center border-b-[3px] border-blue-200">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">Boxes
                                                    </p>
                                                    <p
                                                        class="text-[11px] text-black leading-none font-mono tracking-tighter">
                                                        <%= device.callStats.today.boxes %>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- For the Month -->
                                        <div>
                                            <div class="flex items-center gap-2 mb-1.5">
                                                <i data-lucide="calendar-days" class="w-3.5 h-3.5 text-gray-400"></i>
                                                <span
                                                    class="text-[10px] font-black text-gray-400 capitalize tracking-widest leading-none">For
                                                    the month</span>
                                                <div class="flex-1 h-[0.5px] bg-gray-200"></div>
                                            </div>
                                            <div
                                                class="flex rounded-lg overflow-hidden border border-gray-200 shadow-md">
                                                <div
                                                    class="flex-1 bg-indigo-50 py-2 text-center border-b-[3px] border-indigo-200 border-r border-gray-300 last:border-r-0">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">
                                                        Total</p>
                                                    <p
                                                        class="text-[11px] text-black leading-none font-mono tracking-tighter">
                                                        <%= device.callStats.month.total %>
                                                    </p>
                                                </div>
                                                <div
                                                    class="flex-1 bg-emerald-50 py-2 text-center border-b-[3px] border-emerald-200 border-r border-gray-300 last:border-r-0">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">Ans
                                                    </p>
                                                    <p
                                                        class="text-[11px] text-black leading-none font-mono tracking-tighter">
                                                        <%= device.callStats.month.answered %>
                                                    </p>
                                                </div>
                                                <div
                                                    class="flex-1 bg-red-50 py-2 text-center border-b-[3px] border-red-200 border-r border-gray-300 last:border-r-0">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">Miss
                                                    </p>
                                                    <p
                                                        class="text-[11px] text-black leading-none font-mono tracking-tighter">
                                                        <%= device.callStats.month.missed %>
                                                    </p>
                                                </div>
                                                <div
                                                    class="flex-1 bg-purple-50 py-2 text-center border-b-[3px] border-purple-200 border-r border-gray-300 last:border-r-0">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">Dur
                                                    </p>
                                                    <p
                                                        class="text-[11px] text-black leading-none truncate px-0.5 font-mono tracking-tighter">
                                                        <%= device.callStats.month.duration %>
                                                    </p>
                                                </div>
                                                <div
                                                    class="flex-1 bg-blue-50 py-2 text-center border-b-[3px] border-blue-200">
                                                    <p class="text-[11px] font-medium text-black leading-none mb-1">Boxes
                                                    </p>
                                                    <p
                                                        class="text-[11px] text-black leading-none font-mono tracking-tighter">
                                                        <%= device.callStats.month.boxes %>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div
                                        class="mt-3 flex items-center justify-between px-1 border-t border-gray-50 pt-3">
                                        <p class="text-[8px] font-bold text-gray-400 italic">Total All-Time: <%=
                                                device.callStats.totalCalls %>
                                        </p>
                                        <p class="text-[8px] font-bold text-gray-400 italic">ID: <%= device.id %>
                                        </p>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                        <% } %>
            </div>

            <!-- Device Detail View (Hidden Initially) -->
            <div id="deviceDetails" class="hidden">
                <div class="flex flex-col gap-6 mb-6">
                    <div class="flex flex-col md:flex-row md:items-center gap-6">
                        <div class="flex items-center gap-4 flex-grow">
                            <button onclick="hideDeviceDetails()"
                                class="w-fit p-3 bg-white hover:bg-gray-50 rounded-full shadow-lg border border-gray-100 transition-all active:scale-95 group">
                                <i data-lucide="arrow-left" class="w-6 h-6 text-black group-hover:text-primary-500"></i>
                            </button>
                            <h3 id="detailTitle" class="text-2xl font-black text-gray-900 leading-tight">Device Details
                            </h3>
                        </div>

                        <div
                            class="md:ml-auto flex flex-col sm:flex-row items-center gap-4 bg-primary-50 px-6 py-3 rounded-3xl border border-primary-100 shadow-sm w-full md:w-auto">
                            <div class="flex items-center gap-2">
                                <input type="date" id="rangeStartDate" onchange="applyFilters()"
                                    class="px-3 py-1.5 bg-white border border-primary-200 rounded-xl outline-none focus:ring-2 focus:ring-primary-400 font-bold text-base uppercase">
                                <span class="text-primary-300 font-black">/</span>
                                <input type="date" id="rangeEndDate" onchange="applyFilters()"
                                    class="px-3 py-1.5 bg-white border border-primary-200 rounded-xl outline-none focus:ring-2 focus:ring-primary-400 font-bold text-base uppercase">
                            </div>
                            <button onclick="exportToExcel()"
                                class="w-full sm:w-auto px-6 py-2 bg-primary-600 hover:bg-primary-700 text-white font-black uppercase tracking-widest text-[10px] rounded-xl shadow-lg shadow-primary-600/20 transition-all active:scale-95 flex items-center justify-center gap-2 whitespace-nowrap">
                                <i data-lucide="download-cloud" class="w-3 h-3"></i>
                                Download Logs
                            </button>
                        </div>
                    </div>

                    <!-- Search and Clear (Streamlined) -->
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="relative flex-1">
                            <input type="text" id="tableSearch"
                                placeholder="Search customer, phone, status, outcome, or notes..."
                                class="w-full px-4 py-3 bg-white border border-gray-200 rounded-2xl focus:ring-2 focus:ring-primary-400 focus:border-transparent outline-none transition-all shadow-around-sm text-base text-gray-900"
                                onkeyup="applyFilters()">
                        </div>
                        <button onclick="clearFilters()"
                            class="px-6 py-3 text-sm font-black text-gray-400 hover:text-red-500 bg-white rounded-2xl shadow-around-sm transition-all uppercase tracking-widest border border-gray-100">
                            Clear Filters
                        </button>
                    </div>

                    <div class="glass-card p-8 mt-6">
                        <div id="detailContent" class="space-y-6">
                            <!-- Content will be injected via JavaScript -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/fab', { user, userRole }) %>

            <!-- Client-side Error Box -->
            <div class="max-w-4xl mx-auto px-4 pb-10">
                <div id="clientErrorBox"
                    class="hidden p-6 bg-red-100 border-l-8 border-red-600 text-red-900 rounded-xl shadow-md animate-in fade-in slide-in-from-bottom-4 duration-300">
                    <div class="flex items-start gap-4">
                        <i data-lucide="alert-circle" class="w-8 h-8 text-red-600 shrink-0"></i>
                        <div class="space-y-1">
                            <p class="text-sm font-black uppercase tracking-widest text-red-600">Requirement Not Met</p>
                            <p id="clientErrorText" class="font-bold text-lg leading-tight"></p>
                        </div>
                        <button type="button"
                            onclick="document.getElementById('clientErrorBox').classList.add('hidden')"
                            class="ml-auto text-red-400 hover:text-red-600">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>
            </div>

            <%- include('../partials/footer') %>

                <script>
                    function showClientError(msg) {
                        const errorBox = document.getElementById('clientErrorBox');
                        const errorText = document.getElementById('clientErrorText');
                        if (errorBox && errorText) {
                            errorText.textContent = msg;
                            errorBox.classList.remove('hidden');
                            if (typeof lucide !== 'undefined') lucide.createIcons();
                            errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        } else {
                            alert(msg);
                        }
                    }

                    // Data passed from server - URI encoded to satisfy IDE and avoid quote issues
                    const devices = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(devices)) %>'));

                    let currentDeviceId = null;
                    let currentPage = 1;
                    let totalPages = 1;
                    const itemsPerPage = 20;
                    let isFetching = false;

                    async function fetchLogs(page = 1) {
                        if (!currentDeviceId || isFetching) return;
                        
                        isFetching = true;
                        currentPage = page;
                        
                        const tbody = document.getElementById('callHistoryTableBody');
                        if (tbody) {
                            tbody.innerHTML = '<tr><td colspan="11" class="px-6 py-12 text-center text-gray-400 small-caps tracking-widest font-black uppercase text-[10px]"><div class="flex flex-col items-center justify-center gap-3"><i data-lucide="loader-2" class="w-6 h-6 animate-spin text-primary-500"></i> Fetching Records...</div></td></tr>';
                            if (typeof lucide !== 'undefined') lucide.createIcons();
                        }

                        const search = document.getElementById('tableSearch').value;
                        const startDate = document.getElementById('rangeStartDate').value;
                        const endDate = document.getElementById('rangeEndDate').value;

                        const url = new URL(`/api/telecrm/device/${currentDeviceId}/logs`, window.location.origin);
                        url.searchParams.append('page', page);
                        url.searchParams.append('limit', itemsPerPage);
                        if (search) url.searchParams.append('search', search);
                        if (startDate) url.searchParams.append('startDate', startDate);
                        if (endDate) url.searchParams.append('endDate', endDate);

                        try {
                            const response = await fetch(url);
                            const data = await response.json();
                            
                            if (data.success) {
                                totalPages = data.pagination.totalPages;
                                renderCallHistoryTable(data.logs, data.pagination);
                            } else {
                                throw new Error(data.error || 'Failed to fetch logs');
                            }
                        } catch (err) {
                            console.error('Fetch logs error:', err);
                            showClientError('Error loading logs: ' + err.message);
                        } finally {
                            isFetching = false;
                        }
                    }

                    function showDeviceDetails(deviceId) {
                        currentDeviceId = deviceId;
                        const device = devices.find(d => d.id === deviceId);
                        if (!device) return;

                        const listView = document.getElementById('deviceList');
                        const detailView = document.getElementById('deviceDetails');
                        const detailTitle = document.getElementById('detailTitle');
                        const detailContent = document.getElementById('detailContent');

                        detailTitle.innerText = device.name;
                        
                        detailContent.innerHTML = `
                            <!-- Pagination Controls (Top) -->
                            <div id="paginationControls_Top" class="mb-6 flex items-center justify-between border-b border-gray-100 pb-6">
                                <p id="paginationInfo_Top" class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Loading...</p>
                                <div class="flex items-center gap-2">
                                    <button id="prevPageBtn_Top" 
                                        class="p-2 bg-white border border-gray-200 rounded-lg shadow-sm hover:group-hover:bg-gray-50 disabled:opacity-30 disabled:cursor-not-allowed transition-all relative z-[10002]">
                                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                    </button>
                                    <button id="nextPageBtn_Top" 
                                        class="p-2 bg-white border border-gray-200 rounded-lg shadow-sm hover:group-hover:bg-gray-50 disabled:opacity-30 disabled:cursor-not-allowed transition-all relative z-[10002]">
                                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="overflow-x-auto overflow-y-auto -mx-8 max-h-[500px] border-b border-gray-100 mb-6 relative">
                                <table class="w-full text-left border-collapse min-w-[1600px]">
                                    <thead class="sticky top-0 z-10">
                                        <tr class="bg-gray-50 border-y border-gray-100 shadow-sm">
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Time & Duration</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Mobile Number</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Call Status</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Outcome</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Boxes</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Reminder Date</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Customer Name</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Order Details</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Distributor</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Notes & Remarks</th>
                                            <th class="px-3 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest">Recording</th>
                                        </tr>
                                    </thead>
                                    <tbody id="callHistoryTableBody" class="divide-y divide-gray-50">
                                        <!-- Rows will be injected here -->
                                    </tbody>
                                </table>
                            </div>

                            <!-- STICKY BOTTOM BAR (Polished) -->
                            <div id="paginationControls_Bottom" 
                                class="sticky bottom-[-24px] left-0 right-0 z-[10001] p-4 bg-white/95 backdrop-blur-sm border-t border-gray-100 flex items-center justify-between shadow-[0_-10px_30px_rgba(0,0,0,0.05)] rounded-t-2xl">
                                <p id="paginationInfo_Bottom" class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Loading...</p>
                                <div class="flex items-center gap-3">
                                    <button id="prevPageBtn_Bottom" 
                                        class="p-2.5 bg-gray-50 hover:bg-gray-100 text-gray-600 rounded-xl shadow-sm transition-all active:scale-95 disabled:opacity-20 flex items-center justify-center">
                                        <i data-lucide="chevron-left" class="w-5 h-5"></i>
                                    </button>
                                    <button id="nextPageBtn_Bottom" 
                                        class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-lg shadow-indigo-600/20 transition-all font-black uppercase text-[10px] tracking-widest active:scale-95 disabled:opacity-20 flex items-center gap-2">
                                        Next Page
                                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </div>
                        `;

                        listView.classList.add('hidden');
                        detailView.classList.remove('hidden');
                        window.scrollTo({ top: 0, behavior: 'smooth' });

                        // Initial fetch of logs
                        fetchLogs(1);

                        // Refresh icons
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    }

                    function renderCallHistoryTable(logs, pagination) {
                        const tbody = document.getElementById('callHistoryTableBody');
                        if (!tbody) return;

                        if (!logs || logs.length === 0) {
                            tbody.innerHTML = '<tr><td colspan="11" class="px-6 py-12 text-center text-gray-400">No data found matching your filters</td></tr>';
                            const pcTop = document.getElementById('paginationControls_Top');
                            const pcBot = document.getElementById('paginationControls_Bottom');
                            if (pcTop) pcTop.classList.add('hidden');
                            if (pcBot) pcBot.classList.add('hidden');
                            return;
                        }

                        // Update standard controls visibility
                        const pagContTop = document.getElementById('paginationControls_Top');
                        const pagContBot = document.getElementById('paginationControls_Bottom');
                        if (pagContTop) pagContTop.classList.remove('hidden');
                        if (pagContBot) pagContBot.classList.remove('hidden');

                        tbody.innerHTML = logs.map(log => {
                            try {
                                const outcome = log.outcome || 'No Interaction';
                                const displayOutcome = (outcome === 'No Interaction' || !outcome) ? '-' : outcome;
                                
                                // Safe Date Formatting
                                const safeFormatDate = (dStr) => {
                                    if (!dStr) return '-';
                                    const d = new Date(dStr);
                                    return isNaN(d.getTime()) ? '-' : d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' });
                                };
                                const safeFormatTime = (dStr) => {
                                    if (!dStr) return '-';
                                    const d = new Date(dStr);
                                    return isNaN(d.getTime()) ? '-' : d.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
                                };

                                const displayDate = safeFormatDate(log.timestamp);
                                const displayTime = safeFormatTime(log.timestamp);
                                const reminderDate = safeFormatDate(log.reminder);

                                return `
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="px-3 py-3">
                                        <div class="flex flex-col">
                                            <p class="text-[11px] text-gray-400 font-bold mb-0.5 uppercase tracking-tighter">${displayDate}</p>
                                            <p class="text-sm text-gray-900">${displayTime}</p>
                                            <p class="text-[10px] text-gray-500 font-mono tracking-tighter">${log.duration || '0s'}</p>
                                        </div>
                                    </td>
                                    <td class="px-3 py-3 font-mono text-xs text-gray-600 font-bold">${log.phoneNumber || 'N/A'}</td>
                                    <td class="px-3 py-3">
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-widest 
                                            ${log.callStatus === 'answered' || log.callStatus === 'outgoing' ? 'bg-emerald-100 text-emerald-700' :
                                        log.callStatus === 'missed' || log.callStatus === 'rejected' || log.callStatus === 'incoming' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-500'}">
                                            ${log.callStatus || 'Unknown'}
                                        </span>
                                    </td>
                                    <td class="px-3 py-3">
                                        <p class="text-xs font-bold ${outcome === 'Ordered' ? 'text-emerald-600' : outcome === 'Visited' ? 'text-amber-600' : 'text-gray-400'}">
                                            ${displayOutcome}
                                        </p>
                                    </td>
                                    <td class="px-3 py-3 font-mono text-xs font-bold text-gray-900">${log.totalBoxes || 0}</td>
                                    <td class="px-3 py-3">
                                        ${reminderDate !== '-' ? `<p class="text-xs text-indigo-600 font-bold flex items-center gap-1">
                                            <i data-lucide="calendar" class="w-3 h-3"></i>
                                            ${reminderDate}
                                        </p>` : '-'}
                                    </td>
                                    <td class="px-3 py-3 text-sm font-bold text-gray-900">${log.customerName || '-'}</td>
                                    <td class="px-3 py-3 max-w-[600px]">
                                        <p class="text-[10px] text-gray-600 leading-tight font-medium" title="${String(log.orderDetails || '').replace(/"/g, '&quot;')}">
                                            ${log.orderDetails && log.orderDetails !== 'N/A' ? log.orderDetails : '-'}
                                        </p>
                                    </td>
                                    <td class="px-3 py-3 text-xs font-bold text-indigo-600">${log.distributor || '-'}</td>
                                    <td class="px-3 py-3 max-w-[400px]">
                                        <p class="text-[10px] text-gray-500 leading-tight italic" title="${String(log.remarks || '').replace(/"/g, '&quot;')}">
                                            ${log.remarks || '-'}
                                        </p>
                                    </td>
                                    <td class="px-3 py-3">
                                        ${log.recordingUrl ? `
                                            <a href="${log.recordingUrl}" target="_blank" class="inline-flex items-center gap-1 px-3 py-1 bg-indigo-50 text-indigo-700 rounded-full text-[10px] font-black uppercase tracking-wider hover:bg-indigo-100 transition-all">
                                                Play
                                            </a>
                                        ` : '<span class="text-[10px] text-gray-300 font-bold uppercase tracking-widest">No File</span>'}
                                    </td>
                                </tr>
                                `;
                            } catch (e) {
                                console.error('Row map error:', e);
                                return '<tr><td colspan="11" class="text-red-500 text-xs p-4">Error loading record</td></tr>';
                            }
                        }).join('');

                        const updatePagSet = (suffix) => {
                            const pInfo = document.getElementById(`paginationInfo_${suffix}`);
                            const pPrev = document.getElementById(`prevPageBtn_${suffix}`);
                            const pNext = document.getElementById(`nextPageBtn_${suffix}`);

                            const start = (pagination.currentPage - 1) * pagination.limit + 1;
                            const end = Math.min(pagination.currentPage * pagination.limit, pagination.totalCount);
                            
                            if (pInfo) pInfo.innerText = `Showing ${start}-${end} of ${pagination.totalCount}`;
                            
                            if (pPrev) {
                                pPrev.disabled = (currentPage === 1);
                                pPrev.style.opacity = (currentPage === 1) ? '0.3' : '1';
                            }
                            if (pNext) {
                                pNext.disabled = (currentPage === totalPages);
                                pNext.style.opacity = (currentPage === totalPages) ? '0.3' : '1';
                            }
                        };

                        updatePagSet('Top');
                        updatePagSet('Bottom');

                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    }

                    window.telecrmChangePage = function(direction) {
                        if (isFetching) return;

                        let newPage = currentPage;
                        if (direction === 'next') newPage++;
                        else if (direction === 'prev') newPage--;
                        else newPage = parseInt(direction);

                        if (newPage < 1 || newPage > totalPages || newPage === currentPage) return;
                        
                        fetchLogs(newPage);
                        
                        const detailView = document.getElementById('deviceDetails');
                        if (detailView) detailView.scrollIntoView({ block: 'start', behavior: 'smooth' });
                    };

                    // Global delegated event listener for pagination buttons
                    document.addEventListener('click', function(e) {
                        const target = e.target;
                        const btn = target.closest('#prevPageBtn_Top') || target.closest('#nextPageBtn_Top') || 
                                    target.closest('#prevPageBtn_Bottom') || target.closest('#nextPageBtn_Bottom');
                        if (!btn) return;
                        
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const direction = (btn.id.includes('nextPageBtn')) ? 'next' : 'prev';
                        window.telecrmChangePage(direction);
                    });

                    function applyFilters() {
                        fetchLogs(1); // Reset to page 1 on filter
                    };

                    window.clearFilters = function() {
                        document.getElementById('tableSearch').value = '';
                        document.getElementById('rangeStartDate').value = '';
                        document.getElementById('rangeEndDate').value = '';
                        window.applyFilters();
                    };

                    function exportToExcel() {
                        if (!currentDeviceId) return;

                        const start = document.getElementById('rangeStartDate').value;
                        const end = document.getElementById('rangeEndDate').value;

                        if (!start || !end) {
                            showClientError('Please select both start and end dates to generate the report.');
                            return;
                        }

                        window.location.href = `/headoffice/telecrm/export/${currentDeviceId}?startDate=${start}&endDate=${end}`;
                    }

                    function saveCardTelecaller(deviceId) {
                        const input = document.getElementById(`cardTelecaller_${deviceId}`);
                        const btn = document.getElementById(`saveBtn_${deviceId}`);
                        const newName = input.value.trim();

                        if (!newName) {
                            showClientError('Telecaller name cannot be empty');
                            return;
                        }

                        // Find device in local data
                        const device = devices.find(d => d.id === deviceId);
                        if (!device) return;

                        const originalName = device.telecaller;

                        // Local update
                        device.telecaller = newName;

                        // UI Feedback
                        const originalBtnHTML = btn.innerHTML;
                        btn.innerHTML = '<i data-lucide="check" class="w-4 h-4 text-emerald-500"></i>';
                        btn.classList.add('scale-110');
                        if (typeof lucide !== 'undefined') lucide.createIcons();

                        // Send update to server
                        fetch(`/api/telecrm/device/${deviceId}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ telecaller: newName })
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    setTimeout(() => {
                                        btn.innerHTML = originalBtnHTML;
                                        btn.classList.remove('scale-110');
                                        if (typeof lucide !== 'undefined') lucide.createIcons();
                                    }, 2000);
                                } else {
                                    throw new Error(data.error || 'Failed to update');
                                }
                            })
                            .catch(error => {
                                console.error('Update error:', error);
                                showClientError('Error saving telecaller name: ' + error.message);
                                input.value = originalName;
                                device.telecaller = originalName;
                                btn.innerHTML = originalBtnHTML;
                                btn.classList.remove('scale-110');
                                if (typeof lucide !== 'undefined') lucide.createIcons();
                            });
                    }

                    function hideDeviceDetails() {
                        document.getElementById('deviceList').classList.remove('hidden');
                        document.getElementById('deviceDetails').classList.add('hidden');
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }

                    // Set default dates to today
                    document.addEventListener('DOMContentLoaded', () => {
                        const today = new Date().toISOString().split('T')[0];
                        const startEl = document.getElementById('rangeStartDate');
                        const endEl = document.getElementById('rangeEndDate');
                        if (startEl) startEl.value = today;
                        if (endEl) endEl.value = today;
                    });
                </script>