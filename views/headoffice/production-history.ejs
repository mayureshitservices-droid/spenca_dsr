<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user, userRole }) %>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

            <!-- Header Section -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
                <div class="space-y-2">
                    <h1 class="text-4xl font-black text-black tracking-tight uppercase leading-none">
                        Production History
                    </h1>
                    <p class="text-sm font-bold text-gray-400 uppercase tracking-widest">Daily Manufacturing Log</p>
                </div>
            </div>

            <!-- Transactions Table -->
            <% if (!locals.productionRecords || productionRecords.length===0) { %>
                <div
                    class="bg-white/95 backdrop-blur-md rounded-3xl p-20 text-center shadow-around-lg border border-gray-100">
                    <div class="flex flex-col items-center gap-6">
                        <div
                            class="w-20 h-20 rounded-full bg-gray-50 flex items-center justify-center border border-gray-100">
                            <i data-lucide="factory" class="w-10 h-10 text-gray-200"></i>
                        </div>
                        <div class="space-y-2">
                            <h3 class="text-xl font-black text-gray-900 uppercase tracking-widest">No Production Records
                            </h3>
                            <p class="text-sm font-medium text-gray-400">Manufacturing history will appear here once
                                recorded by the factory.</p>
                        </div>
                    </div>
                </div>
                <% } else { %>
                    <div
                        class="bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg overflow-hidden border border-white/20">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-gray-50 border-b border-gray-100">
                                        <th
                                            class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                            Date</th>
                                        <th
                                            class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                            Shift</th>
                                        <th
                                            class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                            Product</th>
                                        <th
                                            class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                            Batch No</th>
                                        <th
                                            class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-right">
                                            Qty Produced</th>
                                        <th
                                            class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                            Notes</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% productionRecords.forEach(record=> { %>
                                        <tr class="hover:bg-gray-50/80 transition-colors group">
                                            <td class="px-6 py-4 text-sm font-bold text-gray-900 whitespace-nowrap">
                                                <%= new Date(record.createdAt).toLocaleDateString('en-IN', {
                                                    day: '2-digit' , month: 'short' , year: 'numeric' }) %>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span
                                                    class="px-2 py-1 bg-gray-100 text-gray-600 text-[9px] font-black rounded-lg uppercase tracking-widest">
                                                    <%= record.shift %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4">
                                                <div
                                                    class="text-sm font-black text-gray-900 group-hover:text-indigo-600 transition-colors uppercase">
                                                    <%= record.productName %>
                                                </div>
                                                <div
                                                    class="text-[10px] text-gray-400 font-bold uppercase tracking-tighter">
                                                    <%= record.productId ? record.productId.packaging : '' %>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span
                                                    class="px-3 py-1 bg-indigo-50 text-indigo-600 text-[10px] font-black rounded-full uppercase tracking-widest">
                                                    <%= record.batchNo %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-right tabular-nums">
                                                <span class="text-lg font-black text-black leading-none">
                                                    <%= record.quantity %>
                                                </span>
                                                <span class="text-[10px] font-bold text-gray-400 uppercase ml-1">
                                                    <%= record.productId ? record.productId.uom : 'Units' %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 max-w-xs">
                                                <p class="text-[10px] font-medium text-gray-600 line-clamp-2">
                                                    <%= record.remarks || '-' %>
                                                </p>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <% } %>
        </div>

        <%- include('../partials/fab', { user, userRole }) %>
            <%- include('../partials/footer') %>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    });
                </script>