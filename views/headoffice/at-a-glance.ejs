<%- include('../partials/header') %>
<%- include('../partials/navbar', { user, userRole }) %>

<div class="min-h-screen bg-[#fcfcfd] py-4 print:py-0 print:bg-white print:min-h-0">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Premium Header -->
        <header class="relative overflow-hidden mb-3 p-5 rounded-[2rem] bg-white border border-gray-100 shadow-around-sm flex flex-col md:flex-row md:items-center justify-between gap-4 print:border-b-2 print:border-gray-100 print:rounded-none print:shadow-none print:p-0 print:mb-6 print:pb-6">
            <div class="relative z-10">
                <h1 class="text-3xl font-black text-gray-900 tracking-tight flex items-center gap-3 report-title">
                    <span class="w-1.5 h-8 bg-primary-600 rounded-full print:hidden"></span>
                    Daily Report : <span class="text-primary-600"><%= dateStr %></span>
                </h1>
            </div>
            
            <div class="relative z-10 flex items-center gap-3 print:hidden">
                <div class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-100 rounded-2xl shadow-sm group hover:border-primary-200 transition-all">
                    <i data-lucide="calendar" class="w-4 h-4 text-primary-600 group-hover:scale-110 transition-transform"></i>
                    <input 
                        type="date" 
                        id="reportDate" 
                        value="<%= isoDate %>"
                        onchange="changeReportDate(this.value)"
                        class="text-[10px] font-black uppercase tracking-widest text-gray-900 border-none focus:ring-0 cursor-pointer bg-transparent"
                    >
                </div>

                <div class="flex items-center gap-2">
                    <button onclick="switchTab('production')" id="btn-production" class="tab-btn active px-6 py-3 rounded-2xl font-black uppercase tracking-widest text-[10px] transition-all flex items-center gap-2 group">
                        <i data-lucide="factory" class="w-4 h-4"></i>
                        Production
                    </button>
                    <button onclick="switchTab('dispatches')" id="btn-dispatches" class="tab-btn px-6 py-3 rounded-2xl font-black uppercase tracking-widest text-[10px] transition-all flex items-center gap-2 group">
                        <i data-lucide="truck" class="w-4 h-4"></i>
                        Dispatches
                    </button>
                    <button onclick="switchTab('inwards')" id="btn-inwards" class="tab-btn px-6 py-3 rounded-2xl font-black uppercase tracking-widest text-[10px] transition-all flex items-center gap-2 group">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        Inwards
                    </button>
                </div>

                <button onclick="window.print()" class="px-6 py-3 bg-white text-gray-700 font-black uppercase tracking-widest text-[10px] rounded-2xl shadow-sm border border-gray-200 hover:border-gray-400 transition-all active:scale-95 flex items-center gap-2 group">
                    <i data-lucide="printer" class="w-4 h-4 text-gray-500 group-hover:text-gray-700"></i>
                    Print
                </button>
            </div>

            <!-- Background Decoration (Screen Only) -->
            <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary-50 rounded-full blur-3xl opacity-40 print:hidden"></div>
            <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-emerald-50 rounded-full blur-3xl opacity-40 print:hidden"></div>
        </header>

        <% ['indapur', 'shirapur'].forEach(factory => { %>
            <% const data = factoryWiseData[factory] %>
            <div class="mb-4 print:mb-8">
                <div class="space-y-4">
                    <!-- Production -->
                    <section data-tab-content="production" class="tab-content glass-card overflow-hidden flex flex-col">
                        <div class="px-6 py-4 bg-indigo-50/30 border-b border-indigo-100">
                            <h3 class="text-xs font-black text-indigo-900 uppercase tracking-widest flex items-center gap-2">
                                <i data-lucide="factory" class="w-4 h-4"></i>
                                <%= factory %> Factory : Production Details
                            </h3>
                        </div>
                        <div class="flex-grow">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-gray-50/50">
                                    <tr class="border-t border-b border-dashed border-gray-300">
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest border-r border-dashed border-gray-300 border-l">Product Name</th>
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest text-center border-r border-dashed border-gray-300">Shift</th>
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest text-right border-r border-dashed border-gray-300">Quantity</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y-0">
                                    <% if (data.production.length === 0) { %>
                                        <tr><td colspan="3" class="px-6 py-10 text-center text-gray-400 font-bold italic text-xs border-x border-b border-dashed border-gray-300">No production activity recorded for today</td></tr>
                                    <% } else { %>
                                        <% data.production.forEach(rec => { %>
                                            <tr class="hover:bg-gray-50/30 transition-colors border-b border-dashed border-gray-300">
                                                <td class="px-6 py-3 border-r border-dashed border-gray-300 border-l">
                                                    <div class="text-sm font-black text-gray-800 uppercase leading-tight"><%= rec.productName %></div>
                                                </td>
                                                <td class="px-6 py-3 text-center border-r border-dashed border-gray-300">
                                                    <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded-md text-[9px] font-bold uppercase">Shift <%= rec.shift %></span>
                                                </td>
                                                <td class="px-6 py-3 text-sm font-black text-indigo-600 text-right tabular-nums border-r border-dashed border-gray-300"><%= rec.quantity.toLocaleString() %> Boxes</td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <!-- Dispatches -->
                    <section data-tab-content="dispatches" class="tab-content hidden glass-card overflow-hidden flex flex-col">
                        <div class="px-6 py-4 bg-purple-50/30 border-b border-purple-100 flex justify-between items-center">
                            <h3 class="text-xs font-black text-purple-900 uppercase tracking-widest flex items-center gap-2">
                                <i data-lucide="truck" class="w-4 h-4"></i>
                                <%= factory %> Factory : Dispatch Details
                            </h3>
                        </div>
                        <div class="flex-grow">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-gray-50/50">
                                    <tr class="border-t border-b border-dashed border-gray-300">
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest border-r border-dashed border-gray-300 border-l">Customer</th>
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest border-r border-dashed border-gray-300">Products & Quantities</th>
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest text-right border-r border-dashed border-gray-300">Total Boxes</th>
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest text-center border-r border-dashed border-gray-300">DC</th>
                                    </tr>
                                </thead>
                                <tbody class="">
                                    <% if (data.dispatches.length === 0) { %>
                                        <tr><td colspan="4" class="px-6 py-10 text-center text-gray-400 font-bold italic text-xs">No dispatches recorded for today</td></tr>
                                    <% } else { %>
                                        <% data.dispatches.forEach(group => { %>
                                            <tr class="hover:bg-gray-50/30 transition-colors border-b border-dashed border-gray-300">
                                                <td class="px-6 py-4 align-top border-r border-dashed border-gray-300 border-l">
                                                    <div class="text-sm font-black text-gray-800 uppercase leading-tight"><%= group.receiverName %></div>
                                                </td>
                                                <td class="px-6 py-4 border-r border-dashed border-gray-300">
                                                    <div class="space-y-2">
                                                        <% if (group.products) { %>
                                                            <% group.products.forEach(p => { %>
                                                                <div class="flex items-center justify-between gap-4 p-2 bg-gray-50/50 rounded-lg border border-gray-100/50">
                                                                    <div class="flex flex-col">
                                                                        <span class="text-[11px] font-black text-gray-600 uppercase tracking-tight"><%= p.productName %></span>
                                                                        <% if (p.dcNo) { %>
                                                                            <span class="text-[8px] font-bold text-gray-400">DC: #<%= p.dcNo %></span>
                                                                        <% } %>
                                                                    </div>
                                                                    <div class="flex items-center gap-3">
                                                                        <span class="text-[11px] font-black text-purple-600 tabular-nums"><%= p.quantity.toLocaleString() %> Boxes</span>
                                                                    </div>
                                                                </div>
                                                            <% }) %>
                                                        <% } %>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 text-right align-top border-r border-dashed border-gray-300">
                                                    <div class="text-lg font-black text-purple-700 tabular-nums"><%= group.totalBoxes.toLocaleString() %></div>
                                                    <div class="text-[8px] font-black text-gray-400 uppercase tracking-tighter mb-3">Net Boxes</div>
                                                </td>
                                                <td class="px-6 py-4 text-center align-top border-r border-dashed border-gray-300">
                                                    <a href="/headoffice/challan/customer?receiverName=<%= encodeURIComponent(group.receiverName) %>&date=<%= isoDate %>&factory=<%= factory %>" 
                                                       target="_blank" 
                                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 rounded-lg transition-all group/print text-xs font-bold shadow-sm"
                                                       title="Print Full Customer DC">
                                                        <i data-lucide="printer" class="w-3.5 h-3.5 group-hover/print:scale-110 transition-transform"></i>
                                                        Print DC
                                                    </a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <!-- Material Inwards -->
                    <section data-tab-content="inwards" class="tab-content hidden glass-card overflow-hidden flex flex-col">
                        <div class="px-6 py-4 bg-emerald-50/30 border-b border-emerald-100 flex justify-between items-center">
                            <h3 class="text-xs font-black text-emerald-900 uppercase tracking-widest flex items-center gap-2">
                                <i data-lucide="download" class="w-4 h-4"></i>
                                <%= factory %> Factory : Inward Details
                            </h3>
                            <span class="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-[9px] font-black uppercase tracking-tighter">Inward</span>
                        </div>
                        <div class="flex-grow">
                            <table class="w-full text-left border-collapse">
                                <thead class="bg-gray-50/50">
                                    <tr class="border-t border-b border-dashed border-gray-300">
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest border-r border-dashed border-gray-300 border-l">Material / Product</th>
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest text-center border-r border-dashed border-gray-300">Supplier</th>
                                        <th class="px-6 py-3 text-[10px] font-black text-gray-400 uppercase tracking-widest text-right border-r border-dashed border-gray-300">Quantity</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y-0">
                                    <% if (data.inwards.length === 0) { %>
                                        <tr><td colspan="3" class="px-6 py-10 text-center text-gray-400 font-bold italic text-xs border-x border-b border-dashed border-gray-300">No inwards recorded for today</td></tr>
                                    <% } else { %>
                                        <% const categories = Object.keys(data.inwardsByCategory || {}); %>
                                        <% categories.forEach(category => { %>
                                            <tr>
                                                <td colspan="3" class="px-6 py-2 bg-emerald-50/60 border-y border-dashed border-emerald-200 border-x">
                                                    <span class="text-[9px] font-black text-emerald-700 uppercase tracking-[0.2em]"><%= category %></span>
                                                </td>
                                            </tr>
                                            <% data.inwardsByCategory[category].forEach(inw => { %>
                                                <tr class="hover:bg-gray-50/30 transition-colors border-b border-dashed border-gray-300">
                                                    <td class="px-6 py-3 border-r border-dashed border-gray-300 border-l">
                                                        <div class="text-sm font-black text-gray-800 uppercase leading-tight"><%= inw.productName %></div>
                                                    </td>
                                                    <td class="px-6 py-3 text-center border-r border-dashed border-gray-300">
                                                        <div class="text-[10px] font-bold text-gray-500 uppercase truncate max-w-[150px] mx-auto"><%= inw.supplierName %></div>
                                                    </td>
                                                    <td class="px-6 py-3 text-sm font-black text-emerald-600 text-right tabular-nums border-r border-dashed border-gray-300">
                                                        <% 
                                                            const isPreform = inw.productName.toLowerCase().includes('preform');
                                                            let displayQty = inw.quantity;
                                                            let displayUnit = (inw.productId && inw.productId.uom) ? inw.productId.uom : (inw.inwardUnit || 'Boxes');

                                                            if (isPreform) {
                                                                displayUnit = 'KG';
                                                                if (inw.inwardWeight) {
                                                                    displayQty = inw.inwardWeight;
                                                                } else {
                                                                    const gmMatch = inw.productName.match(/(\d+\.?\d*)\s*gm/i);
                                                                    if (gmMatch) {
                                                                        const gmWeight = parseFloat(gmMatch[1]);
                                                                        displayQty = (inw.quantity * gmWeight) / 1000;
                                                                    }
                                                                }
                                                            }
                                                        %>
                                                        <%= displayQty.toLocaleString(undefined, { minimumFractionDigits: isPreform ? 2 : 0, maximumFractionDigits: 2 }) %> <%= displayUnit %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
            </div>
        <% }) %>

    </div>
</div>

<%- include('../partials/fab', { user, userRole }) %>
<%- include('../partials/footer') %>

<script>
    function changeReportDate(date) {
        if (!date) return;
        window.location.href = `/headoffice/report/yesterday?date=${date}`;
    }

    function switchTab(category) {
        // Update Content
        document.querySelectorAll('.tab-content').forEach(el => {
            if (el.getAttribute('data-tab-content') === category) {
                el.classList.remove('hidden');
            } else {
                el.classList.add('hidden');
            }
        });

        // Update Buttons
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('active');
        });
        document.getElementById(`btn-${category}`).classList.add('active');

        // Refresh icons (lucide)
        if (window.lucide) {
            lucide.createIcons();
        }
    }
</script>

<style>
.report-title {
    display: none;
}
.tab-btn {
    background-color: #ffffff !important;
    color: #6b7280 !important;
    border: 1px solid #e5e7eb !important;
    font-weight: 900 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
    font-size: 10px !important;
    padding: 0.75rem 2rem !important;
    border-radius: 1rem !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;
    transition: all 0.2s !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
}

.tab-btn:hover {
    border-color: #1C2574 !important;
    color: #1C2574 !important;
    transform: translateY(-1px) !important;
}

.tab-btn.active {
    background-color: #1C2574 !important;
    color: #ffffff !important;
    border-color: #1C2574 !important;
    box-shadow: 0 20px 25px -5px rgba(28, 37, 116, 0.25) !important;
}

/* Glass Component */
.glass-card {
    background-color: #ffffff !important;
    border-radius: 1.5rem !important;
    border: 1px solid #f3f4f6 !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;
    transition: all 0.3s ease !important;
}

.glass-card:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1) !important;
    transform: translateY(-2px) !important;
    border-color: #e1e5ff !important;
}

@media print {
    @page {
        size: A4 portrait;
        margin: 4mm;
    }
    body {
        margin: 0;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
    .min-h-screen { min-height: 0 !important; }
    nav, footer, .fab-container, #fabMain, [data-lucide="printer"] { display: none !important; }
    .report-title { display: flex !important; }
    
    /* Strict One Page Grid */
    .grid {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        gap: 6px !important;
    }
    section {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
    }
    .text-xs { font-size: 7.5px !important; }
    .text-\[10px\] { font-size: 7px !important; }
    .text-3xl { font-size: 14px !important; }
    .text-sm { font-size: 10px !important; }
    .px-6 { padding-left: 8px !important; padding-right: 8px !important; }
    .py-4 { padding-top: 4px !important; padding-bottom: 4px !important; }
    .px-4 { padding-left: 6px !important; padding-right: 6px !important; }
    .py-3 { padding-top: 3px !important; padding-bottom: 3px !important; }
    .py-2 { padding-top: 2px !important; padding-bottom: 2px !important; }
    .mb-8 { margin-bottom: 8px !important; }
    .mb-4 { margin-bottom: 4px !important; }
    
    .glass-card {
        border-radius: 12px !important;
        border: 1px solid #f0f0f0 !important;
        background-color: white !important;
    }
}
</style>
