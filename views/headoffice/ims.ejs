                <script>

                    function showSection(sectionId) {
                        const sections = ['stock-section', 'fg-stock-section', 'production-section', 'suppliers-section', 'customers-section', 'inward-section', 'dispatch-section', 'mrp-section'];

                        // Close FAB menu first
                        const fabBackdrop = document.getElementById('fabBackdrop');
                        if (fabBackdrop && !fabBackdrop.classList.contains('invisible')) {
                            fabBackdrop.click();
                        }

                        sections.forEach(id => {
                            const el = document.getElementById(id);
                            if (el) {
                                if (id === sectionId) {
                                    el.classList.remove('hidden');
                                    // Update hash without triggering reload
                                    history.replaceState(null, null, '#' + id);
                                    setTimeout(() => {
                                        el.scrollIntoView({ behavior: 'smooth' });
                                    }, 50);
                                } else {
                                    el.classList.add('hidden');
                                }
                            }
                        });
                    }

                    function openAddSupplierModal() {
                        const modal = document.getElementById('addSupplierModal');
                        if (modal) {
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                            document.body.style.overflow = 'hidden';
                        }
                    }

                    function openAddCustomerModal() {
                        const modal = document.getElementById('addCustomerModal');
                        if (modal) {
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                            document.body.style.overflow = 'hidden';
                        }
                    }

                    function closeAddCustomerModal() {
                        const modal = document.getElementById('addCustomerModal');
                        if (modal) {
                            modal.classList.remove('flex');
                            modal.classList.add('hidden');
                            document.body.style.overflow = '';
                        }
                    }

                    function closeAddSupplierModal() {
                        const modal = document.getElementById('addSupplierModal');
                        if (modal) {
                            modal.classList.remove('flex');
                            modal.classList.add('hidden');
                            document.body.style.overflow = '';
                        }
                    }

                    // Handle view persistence via hash
                    document.addEventListener('DOMContentLoaded', function () {
                        lucide.createIcons();

                        const hash = window.location.hash.substring(1);
                        const validSections = ['stock-section', 'fg-stock-section', 'production-section', 'suppliers-section', 'customers-section', 'inward-section', 'dispatch-section', 'mrp-section'];

                        if (hash && validSections.includes(hash)) {
                            showSection(hash);
                        } else {
                            showSection('stock-section');
                        }
                    });

                    // --- MRP Logic ---
                    let mrpRowCount = 1;

                    // Initialize first row
                    document.addEventListener('DOMContentLoaded', function () {
                        initializeMRPAutocomplete(1);
                    });

                    function initializeMRPAutocomplete(id) {
                        const input = document.getElementById(`mrpProductInput_${id}`);
                        const suggestions = document.getElementById(`mrpSuggestions_${id}`);
                        
                        if (!input || !suggestions) return;

                        // Reusing debounce and search logic structure
                        const debounce = (fn, wait) => {
                            let timeout;
                            return (...args) => {
                                clearTimeout(timeout);
                                timeout = setTimeout(() => fn(...args), wait);
                            };
                        };

                        const search = debounce(async (query) => {
                            if (query.length < 2) {
                                suggestions.classList.add('hidden');
                                return;
                            }

                            try {
                                const response = await fetch(`/api/factory-incharge/products/search-fg?q=${encodeURIComponent(query)}`);
                                const data = await response.json();

                                suggestions.innerHTML = '';
                                if (data.length > 0) {
                                    data.forEach(item => {
                                        const div = document.createElement('div');
                                        div.className = 'p-3 hover:bg-indigo-50 cursor-pointer border-b border-gray-50 last:border-0 transition-colors group';
                                        div.innerHTML = `
                                            <div class="flex justify-between items-center">
                                                <span class="text-xs font-black text-gray-900 group-hover:text-indigo-600 uppercase">${item.productName}</span>
                                                <span class="text-[9px] font-bold text-gray-400">${item.packaging || '1'} n/b</span>
                                            </div>
                                        `;
                                        div.addEventListener('click', () => {
                                            input.value = item.productName;
                                            document.getElementById(`mrpProductId_${id}`).value = item._id;
                                            suggestions.classList.add('hidden');
                                        });
                                        suggestions.appendChild(div);
                                    });
                                    suggestions.classList.remove('hidden');
                                }
                            } catch (e) { console.error(e); }
                        }, 300);

                        input.addEventListener('input', (e) => search(e.target.value));
                    }

                    function addMRPProductRow() {
                        mrpRowCount++;
                        const container = document.getElementById('mrpItemsContainer');
                        const row = document.createElement('div');
                        row.className = 'mrp-row relative space-y-4 bg-gray-50/50 p-4 rounded-2xl border border-gray-100 animate-in fade-in slide-in-from-bottom-2 duration-300';
                        row.id = `mrpRow_${mrpRowCount}`;
                        row.innerHTML = `
                            <button onclick="removeMRPRow(${mrpRowCount})" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors bg-white rounded-xl border border-gray-100 shadow-sm z-10" title="Remove Product">
                                <i data-lucide="x" class="w-4 h-4"></i>
                            </button>
                            <div class="space-y-2 pr-10">
                                <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Finished Good *</label>
                                <div class="relative">
                                    <input type="text" id="mrpProductInput_${mrpRowCount}" required autocomplete="off" class="input-field shadow-sm text-sm w-full" placeholder="Search product name...">
                                    <input type="hidden" id="mrpProductId_${mrpRowCount}" class="mrp-item-id">
                                    <div class="absolute left-0 right-0 top-full mt-2 bg-white rounded-xl shadow-2xl border border-gray-100 overflow-hidden z-[100] hidden suggestions-box" id="mrpSuggestions_${mrpRowCount}"></div>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Target Boxes *</label>
                                <input type="number" id="mrpQuantity_${mrpRowCount}" required class="input-field shadow-sm text-sm w-full mrp-item-qty" placeholder="0">
                            </div>
                        `;
                        container.appendChild(row);
                        lucide.createIcons();
                        initializeMRPAutocomplete(mrpRowCount);
                    }

                    function removeMRPRow(id) {
                        const row = document.getElementById(`mrpRow_${id}`);
                        if (document.querySelectorAll('.mrp-row').length > 1) {
                            row.remove();
                        }
                    }

                    async function runMRPCalculation() {
                        const btn = document.getElementById('runMRPBtn');
                        const icon = document.getElementById('mrpBtnIcon');
                        const factory = document.getElementById('mrpFactory').value;
                        const items = [];
                        
                        document.querySelectorAll('.mrp-row').forEach(row => {
                            const id = row.id.split('_')[1];
                            const productId = document.getElementById(`mrpProductId_${id}`).value;
                            const qty = document.getElementById(`mrpQuantity_${id}`).value;
                            if (productId && qty > 0) {
                                items.push({ productId, quantity: qty });
                            }
                        });

                        if (items.length === 0) {
                            alert('Please select at least one product with quantity');
                            return;
                        }

                        // Start Loading
                        btn.disabled = true;
                        icon.classList.add('animate-spin');
                        btn.innerHTML = 'Calculating...';

                        try {
                            const response = await fetch('/headoffice/mrp/calculate', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ items, factory })
                            });
                            
                            const data = await response.json();
                            displayMRPResults(data.rawMaterials, data.finishedGoods);
                        } catch (e) {
                            console.error(e);
                            alert('Calculation failed. Please try again.');
                        } finally {
                            btn.disabled = false;
                            btn.innerHTML = '<i data-lucide="calculator" class="w-5 h-5"></i> Run MRP';
                            lucide.createIcons();
                        }
                    }

                    function displayMRPResults(rmResults, fgResults) {
                        const tableRm = document.getElementById('mrpRmTable');
                        const contentRm = document.getElementById('mrpRmContent');
                        const tableFg = document.getElementById('mrpFgTable');
                        const contentFg = document.getElementById('mrpFgStockContent');
                        const bodyFg = document.getElementById('mrpFgResultsBody');
                        
                        // Render FG Stock
                        bodyFg.innerHTML = '';
                        if (fgResults && fgResults.length > 0) {
                            fgResults.forEach(fg => {
                                const row = document.createElement('tr');
                                row.className = 'hover:bg-gray-50/50 transition-colors';
                                const produceQty = Math.max(0, fg.targetQty - fg.availableQty);
                                row.innerHTML = `
                                    <td class="px-2 py-3 border-b border-gray-100">
                                        <div class="text-[10px] font-black text-gray-900 uppercase leading-snug">${fg.name}</div>
                                        <div class="text-[9px] font-bold text-gray-400 uppercase">${fg.packaging} N/B</div>
                                    </td>
                                    <td class="px-2 py-3 text-right border-b border-gray-100">
                                        <span class="text-xs font-bold text-gray-800">${fg.targetQty}</span>
                                    </td>
                                    <td class="px-2 py-3 text-right border-b border-gray-100">
                                        <span class="text-xs font-bold text-emerald-600">${fg.availableQty}</span>
                                    </td>
                                    <td class="px-2 py-3 text-right border-b border-gray-100">
                                        <span class="text-xs font-black text-indigo-600">${produceQty}</span>
                                    </td>
                                `;
                                bodyFg.appendChild(row);
                            });
                            contentFg.classList.add('hidden');
                            tableFg.classList.remove('hidden');
                        } else {
                            contentFg.classList.remove('hidden');
                            tableFg.classList.add('hidden');
                        }

                        // Render RM Results
                        tableRm.innerHTML = '';
                        if (rmResults && rmResults.length > 0) {
                            rmResults.forEach(res => {
                                const isShortage = res.status === 'Shortage';
                                const card = document.createElement('div');
                                card.className = `p-4 bg-gray-50/80 rounded-2xl border ${isShortage ? 'border-red-100' : 'border-emerald-100'} hover:shadow-md transition-all`;
                                card.innerHTML = `
                                    <div class="flex justify-between items-start mb-3">
                                        <span class="text-xs font-black text-gray-900 uppercase leading-tight pr-2">${res.name}</span>
                                        <span class="px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-widest ${isShortage ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700'}">${res.status}</span>
                                    </div>
                                    <div class="flex items-end justify-between mt-2">
                                        <div class="flex-1">
                                            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1 transition-transform">Needed</p>
                                            <p class="text-[13px] font-bold text-gray-700 tracking-tight">${res.requiredQty} <span class="text-[9px] uppercase tracking-widest">${res.uom}</span></p>
                                        </div>
                                        <div class="flex-1 text-center border-l border-gray-200">
                                            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1 transition-transform">Stock</p>
                                            <p class="text-[13px] font-bold text-indigo-600 tracking-tight">${res.availableQty} <span class="text-[9px] uppercase tracking-widest">${res.uom}</span></p>
                                        </div>
                                        <div class="flex-1 text-right border-l border-gray-200 pl-2">
                                            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1 transition-transform">Bal</p>
                                            <p class="text-[13px] font-black tracking-tight ${isShortage ? 'text-red-600' : 'text-emerald-600'}">${isShortage ? '-' : '+'}${Math.abs(res.balance)}</p>
                                        </div>
                                    </div>
                                `;
                                tableRm.appendChild(card);
                            });
                            contentRm.classList.add('hidden');
                            tableRm.classList.remove('hidden');
                            document.getElementById('assignPlanContainer').classList.remove('hidden');
                        } else {
                            contentRm.classList.remove('hidden');
                            tableRm.classList.add('hidden');
                            document.getElementById('assignPlanContainer').classList.add('hidden');
                        }
                    }

                    async function assignProductionPlan() {
                        const factory = document.getElementById('mrpFactory').value;
                        const items = [];
                        let hasErrors = false;
                        
                        document.querySelectorAll('.mrp-row').forEach(row => {
                            const id = row.id.split('_')[1];
                            const productId = document.getElementById(`mrpProductId_${id}`).value;
                            const qty = parseInt(document.getElementById(`mrpQuantity_${id}`).value, 10);
                            
                            if (productId && qty > 0) {
                                items.push({ productId, targetBoxes: qty });
                            } else if (document.getElementById(`mrpProductInput_${id}`).value.trim() !== '') {
                                hasErrors = true;
                            }
                        });

                        if (items.length === 0 || hasErrors) {
                            alert('Please ensure all selected products have a valid target quantity greater than zero.');
                            return;
                        }

                        if (!confirm(`Are you sure you want to assign this production plan for ${factory.toUpperCase()} factory?`)) {
                            return;
                        }

                        const btn = document.getElementById('assignPlanBtn');
                        const originalText = btn.innerHTML;
                        btn.disabled = true;
                        btn.innerHTML = 'Assigning...';

                        try {
                            const response = await fetch('/headoffice/mrp/assign', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ factory, items })
                            });
                            
                            if (response.ok) {
                                alert('Production plan assigned successfully!');
                                // Reset the form
                                document.getElementById('mrpItemsContainer').innerHTML = '';
                                mrpRowCount = 0;
                                addMRPProductRow();
                                
                                // Reset Results
                                document.getElementById('mrpFgResultsBody').innerHTML = '';
                                document.getElementById('mrpFgStockContent').classList.remove('hidden');
                                document.getElementById('mrpFgTable').classList.add('hidden');
                                
                                document.getElementById('mrpRmTable').innerHTML = '';
                                document.getElementById('mrpRmContent').classList.remove('hidden');
                                document.getElementById('mrpRmTable').classList.add('hidden');
                                
                                document.getElementById('assignPlanContainer').classList.add('hidden');
                            } else {
                                const err = await response.json();
                                alert(err.error || 'Failed to assign plan');
                            }
                        } catch (e) {
                            console.error(e);
                            alert('An error occurred while assigning the plan.');
                        } finally {
                            btn.disabled = false;
                            btn.innerHTML = originalText;
                            lucide.createIcons();
                        }
                    }
                </script>