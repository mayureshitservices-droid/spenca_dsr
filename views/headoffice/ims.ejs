<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user, userRole }) %>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

            <!-- RM Stock Section -->
            <div class="mb-16 scroll-mt-24" id="stock-section">
                <div class="flex items-center gap-4 mb-8">
                    <h2 class="text-3xl font-black text-gray-900 tracking-tight">Raw Materials</h2>
                    <span
                        class="px-4 py-1.5 bg-emerald-100 text-emerald-700 text-xs font-black rounded-full uppercase tracking-widest leading-none">Inventory</span>
                </div>

                <!-- Search Bar -->
                <div class="mb-8">
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i data-lucide="search"
                                class="w-5 h-5 text-gray-400 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        <input type="text" id="rmStockSearch" placeholder="Search by material name or specification..."
                            style="padding-left: 3.75rem; padding-right: 1.5rem; padding-top: 1.25rem; padding-bottom: 1.25rem;"
                            class="w-full bg-white/95 backdrop-blur-md border border-gray-200 rounded-2xl text-sm font-bold text-gray-900 placeholder-gray-400 outline-none shadow-around-lg transition-all" />
                    </div>
                </div>

                <% if (rawMaterials.length===0) { %>
                    <div class="bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                        <i data-lucide="box" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Raw Materials</h3>
                        <p class="text-gray-500 font-medium">Add raw materials from the Products page.</p>
                    </div>
                    <% } else { %>
                        <div id="rmStockTableView"
                            class="bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg overflow-hidden border border-white/20">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-gray-50 border-b border-gray-100">
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Material Name</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Specification</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-indigo-600 uppercase tracking-widest text-right">
                                                Indapur Stock</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-purple-600 uppercase tracking-widest text-right">
                                                Shirapur Stock</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100">
                                        <% rawMaterials.forEach(function(material) { %>
                                                <tr class="rm-row hover:bg-gray-50/80 transition-colors group">
                                                    <td class="px-6 py-4">
                                                        <div
                                                            class="text-sm font-black text-gray-900 group-hover:text-emerald-600 transition-colors uppercase">
                                                            <%= material.productName %>
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <span
                                                            class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                                                            <%= material.specification || '-' %>
                                                        </span>
                                                    </td>
                                                    <td class="px-6 py-4 text-right tabular-nums">
                                                        <span class="text-sm font-black text-indigo-600">
                                                            <%= (material.factoryStock?.indapur || 0).toFixed(2) %>
                                                        </span>
                                                    </td>
                                                    <td class="px-6 py-4 text-right tabular-nums">
                                                        <span class="text-sm font-black text-purple-600">
                                                            <%= (material.factoryStock?.shirapur || 0).toFixed(2) %>
                                                        </span>
                                                    </td>
                                                    
                                                </tr>
                                                <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- No Results Message -->
                        <div id="rmNoResults"
                            class="hidden bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                            <i data-lucide="search-x" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">No Matching Materials</h3>
                            <p class="text-gray-500 font-medium">Try adjusting your search terms.</p>
                        </div>
                        <% } %>
            </div>

            <!-- FG Stock Section -->
            <div class="mb-16 scroll-mt-24 hidden" id="fg-stock-section">
                <div class="flex items-center gap-4 mb-8">
                    <h2 class="text-3xl font-black text-gray-900 tracking-tight">Finished Goods</h2>
                    <span
                        class="px-4 py-1.5 bg-indigo-100 text-indigo-700 text-xs font-black rounded-full uppercase tracking-widest leading-none">Inventory</span>
                </div>

                <!-- Search Bar -->
                <div class="mb-8">
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i data-lucide="search"
                                class="w-5 h-5 text-gray-400 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        <input type="text" id="fgStockSearch" placeholder="Search by product name or packaging..."
                            style="padding-left: 3.75rem; padding-right: 1.5rem; padding-top: 1.25rem; padding-bottom: 1.25rem;"
                            class="w-full bg-white/95 backdrop-blur-md border border-gray-200 rounded-2xl text-sm font-bold text-gray-900 placeholder-gray-400 outline-none shadow-around-lg transition-all" />
                    </div>
                </div>

                <% if (finishedGoods.length===0) { %>
                    <div class="bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                        <i data-lucide="package" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Finished Goods</h3>
                        <p class="text-gray-500 font-medium">Manufacturing history will calculate finished stocks.</p>
                    </div>
                    <% } else { %>
                        <div id="fgStockTableView"
                            class="bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg overflow-hidden border border-white/20">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-gray-50 border-b border-gray-100">
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Product Name</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Packaging</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-indigo-600 uppercase tracking-widest text-right">
                                                Indapur Stock</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-purple-600 uppercase tracking-widest text-right">
                                                Shirapur Stock</th>
                                            
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100">
                                        <% finishedGoods.forEach(function(product) { %>
                                                <tr class="fg-row hover:bg-gray-50/80 transition-colors group">
                                                    <td class="px-6 py-4">
                                                        <div
                                                            class="text-sm font-black text-gray-900 group-hover:text-indigo-600 transition-colors uppercase">
                                                            <%= product.productName %>
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <span
                                                            class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                                                            <%= product.packaging || '-' %>
                                                        </span>
                                                    </td>
                                                    <td class="px-6 py-4 text-right tabular-nums">
                                                        <span class="text-sm font-black text-indigo-600">
                                                            <%= (product.factoryStock?.indapur || 0).toFixed(0) %>
                                                        </span>
                                                    </td>
                                                    <td class="px-6 py-4 text-right tabular-nums">
                                                        <span class="text-sm font-black text-purple-600">
                                                            <%= (product.factoryStock?.shirapur || 0).toFixed(0) %>
                                                        </span>
                                                    </td>
                                                    
                                                </tr>
                                                <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- No Results Message -->
                        <div id="fgNoResults"
                            class="hidden bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                            <i data-lucide="search-x" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">No Matching Products</h3>
                            <p class="text-gray-500 font-medium">Try adjusting your search terms.</p>
                        </div>
                        <% } %>
            </div>

            <!-- Production Section -->
            <div class="mb-16 scroll-mt-24 hidden" id="production-section">
                <div class="flex items-center gap-4 mb-8">
                    <h2 class="text-3xl font-black text-gray-900 tracking-tight">Production Records</h2>
                    <span
                        class="px-4 py-1.5 bg-purple-100 text-purple-700 text-xs font-black rounded-full uppercase tracking-widest leading-none">Manufacturing</span>
                </div>

                <!-- Search Bar -->
                <div class="mb-8">
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i data-lucide="search"
                                class="w-5 h-5 text-gray-400 group-focus-within:text-purple-500 transition-colors"></i>
                        </div>
                        <input type="text" id="productionSearch" placeholder="Search by product name, batch or shift..."
                            style="padding-left: 3.75rem; padding-right: 1.5rem; padding-top: 1.25rem; padding-bottom: 1.25rem;"
                            class="w-full bg-white/95 backdrop-blur-md border border-gray-200 rounded-2xl text-sm font-bold text-gray-900 placeholder-gray-400 outline-none shadow-around-lg transition-all" />
                    </div>
                </div>

                <% if (!locals.productionRecords || productionRecords.length===0) { %>
                    <div class="bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                        <i data-lucide="factory" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Records</h3>
                        <p class="text-gray-500 font-medium">Production history will appear once recorded.</p>
                    </div>
                    <% } else { %>
                        <div id="productionTableView"
                            class="bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg overflow-hidden border border-white/20">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-gray-50 border-b border-gray-100">
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Date</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Shift</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Product</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Batch</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Factory</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-right">
                                                Produced</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100">
                                        <% productionRecords.forEach(record=> { %>
                                            <tr
                                                class="production-row hover:bg-gray-50/80 transition-colors group text-sm">
                                                <td class="px-6 py-4 font-bold text-gray-900">
                                                    <%= new Date(record.createdAt).toLocaleDateString('en-IN', {
                                                        day: '2-digit' , month: 'short' }) %>
                                                </td>
                                                <td class="px-6 py-4">
                                                    <span
                                                        class="px-2 py-0.5 bg-gray-100 text-[9px] font-black rounded uppercase">
                                                        <%= record.shift %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 font-bold uppercase">
                                                    <%= record.productName %>
                                                </td>
                                                <td class="px-6 py-4 text-xs font-mono text-indigo-600">
                                                    <%= record.batchNo %>
                                                </td>
                                                <td class="px-6 py-4">
                                                    <span class="px-2 py-0.5 bg-indigo-50 text-indigo-600 text-[9px] font-black rounded uppercase">
                                                        <%= record.factory %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 text-right">
                                                    <span class="font-black">
                                                        <%= record.quantity %>
                                                    </span>
                                                    <span class="text-[9px] text-gray-400 uppercase">
                                                        <%= record.productId?.uom || 'U' %>
                                                    </span>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- No Results Message -->
                        <div id="productionNoResults"
                            class="hidden bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                            <i data-lucide="search-x" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">No Matching Records</h3>
                            <p class="text-gray-500 font-medium">Try adjusting your search terms.</p>
                        </div>
                        <% } %>
            </div>

            <!-- Suppliers Section -->
            <div class="mb-16 scroll-mt-24 hidden" id="suppliers-section">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-8">
                    <div class="flex items-center gap-4">
                        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Suppliers</h2>
                        <span
                            class="px-4 py-1.5 bg-orange-100 text-orange-700 text-xs font-black rounded-full uppercase tracking-widest leading-none">Partners</span>
                    </div>
                    <button onclick="openAddSupplierModal()"
                        class="inline-flex items-center gap-3 py-3 px-6 text-white font-bold rounded-2xl transition-all transform hover:scale-105 shadow-lg"
                        style="background-color: #1C2574; box-shadow: 0 10px 15px -3px rgba(28, 37, 116, 0.3);">
                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                        Add New Supplier
                    </button>
                </div>

                <!-- Search Bar -->
                <div class="mb-8">
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i data-lucide="search"
                                class="w-5 h-5 text-gray-400 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        <input type="text" id="supplierSearch" placeholder="Search by supplier name, phone or GST..."
                            style="padding-left: 3.75rem; padding-right: 1.5rem; padding-top: 1.25rem; padding-bottom: 1.25rem;"
                            class="w-full bg-white/95 backdrop-blur-md border border-gray-200 rounded-2xl text-sm font-bold text-gray-900 placeholder-gray-400 outline-none shadow-around-lg transition-all" />
                    </div>
                </div>

                <% if (suppliers.length===0) { %>
                    <div class="bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                        <i data-lucide="truck" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Suppliers Yet</h3>
                        <p class="text-gray-500 font-medium">Add your first supplier to get started.</p>
                    </div>
                    <% } else { %>
                        <div id="supplierTableView"
                            class="bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg overflow-hidden border border-white/20">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-gray-50 border-b border-gray-100">
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Supplier Name</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Phone Number</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                GST No</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100">
                                        <% suppliers.forEach(function(supplier) { %>
                                            <tr class="supplier-row hover:bg-gray-50/80 transition-colors">
                                                <td class="px-6 py-4 text-sm font-bold text-gray-900">
                                                    <%= supplier.supplierName %>
                                                </td>
                                                <td class="px-6 py-4 text-sm font-medium text-gray-700 font-mono">
                                                    <%= supplier.phoneNumber || '-' %>
                                                </td>
                                                <td class="px-6 py-4 text-sm font-medium text-gray-600 font-mono">
                                                    <%= supplier.gstNo || '-' %>
                                                </td>
                                                <td class="px-6 py-4">
                                                    <span
                                                        class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest <%= supplier.status === 'Active' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                                                        <%= supplier.status %>
                                                    </span>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- No Results Message -->
                        <div id="supplierNoResults"
                            class="hidden bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                            <i data-lucide="search-x" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">No Matching Suppliers</h3>
                            <p class="text-gray-500 font-medium">Try adjusting your search terms.</p>
                        </div>
                        <% } %>
            </div>

            <!-- Customers Section -->
            <div class="mb-16 scroll-mt-24 hidden" id="customers-section">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-8">
                    <div class="flex items-center gap-4">
                        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Customers</h2>
                        <span
                            class="px-4 py-1.5 bg-indigo-100 text-indigo-700 text-xs font-black rounded-full uppercase tracking-widest leading-none">Directory</span>
                    </div>
                    <button onclick="openAddCustomerModal()"
                        class="inline-flex items-center gap-3 py-3 px-6 text-white font-bold rounded-2xl transition-all transform hover:scale-105 shadow-lg"
                        style="background-color: #1C2574; box-shadow: 0 10px 15px -3px rgba(28, 37, 116, 0.3);">
                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                        Add New Customer
                    </button>
                </div>

                <!-- Search Bar -->
                <div class="mb-8">
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                            <i data-lucide="search"
                                class="w-5 h-5 text-gray-400 group-focus-within:text-indigo-500 transition-colors"></i>
                        </div>
                        <input type="text" id="customerSearch"
                            placeholder="Search by name, category, mobile or address..."
                            style="padding-left: 3.75rem; padding-right: 1.5rem; padding-top: 1.25rem; padding-bottom: 1.25rem;"
                            class="w-full bg-white/95 backdrop-blur-md border border-gray-200 rounded-2xl text-sm font-bold text-gray-900 placeholder-gray-400 outline-none shadow-around-lg transition-all" />
                    </div>
                </div>

                <% if (customers.length===0) { %>
                    <div class="bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                        <i data-lucide="users" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Customers</h3>
                        <p class="text-gray-500 font-medium">Customer list is empty.</p>
                    </div>
                    <% } else { %>
                        <div id="customerTableView"
                            class="bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg overflow-hidden border border-white/20">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-gray-50 border-b border-gray-100">
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Customer Name</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Category</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Mobile</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                                                Address</th>
                                            <th
                                                class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-center">
                                                Type</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100">
                                        <% customers.forEach(function(customer) { %>
                                            <tr class="customer-row hover:bg-gray-50/80 transition-colors">
                                                <td class="px-6 py-4 text-sm font-bold text-gray-900">
                                                    <%= customer.customerName %>
                                                </td>
                                                <td class="px-6 py-4 text-sm font-medium text-gray-700">
                                                    <%= customer.category || '-' %>
                                                </td>
                                                <td class="px-6 py-4 text-sm font-medium text-gray-600 font-mono">
                                                    <%= customer.mobileNo || '-' %>
                                                </td>
                                                <td class="px-6 py-4 text-sm font-medium text-gray-600">
                                                    <%= customer.address || '-' %>
                                                </td>
                                                <td class="px-6 py-4 text-center">
                                                    <span
                                                        class="px-2 py-1 rounded-lg text-[9px] font-black uppercase tracking-widest <%= customer.customerType === 'Branded' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-700' %>">
                                                        <%= customer.customerType || 'Regular' %>
                                                    </span>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- No Results Message -->
                        <div id="customerNoResults"
                            class="hidden bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                            <i data-lucide="search-x" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">No Matching Customers</h3>
                            <p class="text-gray-500 font-medium">Try adjusting your search terms.</p>
                        </div>
                        <% } %>
            </div>

            <!-- Inward History Section -->
            <div class="mb-16 scroll-mt-24 hidden" id="inward-section">
                <div class="flex items-center gap-4 mb-8">
                    <h2 class="text-3xl font-black text-gray-900 tracking-tight">Inward Records</h2>
                    <span
                        class="px-4 py-1.5 bg-blue-100 text-blue-700 text-xs font-black rounded-full uppercase tracking-widest leading-none">Log</span>
                </div>

                <% if (inwardTransactions.length===0) { %>
                    <div class="bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                        <i data-lucide="clipboard-list" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Inward Records</h3>
                        <p class="text-gray-500 font-medium">No material inward history found.</p>
