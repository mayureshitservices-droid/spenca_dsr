        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof lucide !== 'undefined') lucide.createIcons();

                // 1. Raw Materials Search
                const rmSearch = document.getElementById('rmStockSearch');
                const rmNoResults = document.getElementById('rmNoResults');
                const rmRows = document.querySelectorAll('.rm-row');
                const rmTable = document.getElementById('rmStockTableView');

                if (rmSearch) {
                    rmSearch.addEventListener('input', function (e) {
                        const term = e.target.value.toLowerCase().trim();
                        let count = 0;
                        rmRows.forEach(row => {
                            const name = row.querySelector('td:first-child').textContent.toLowerCase();
                            const spec = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
                            const matches = name.includes(term) || spec.includes(term);
                            row.style.display = matches ? '' : 'none';
                            if (matches) count++;
                        });

                        if (count === 0 && term !== '') {
                            if (rmTable) rmTable.classList.add('hidden');
                            rmNoResults.classList.remove('hidden');
                        } else {
                            if (rmTable) rmTable.classList.remove('hidden');
                            rmNoResults.classList.add('hidden');
                        }
                    });

                    // Premium focus effect
                    rmSearch.addEventListener('focus', function () {
                        this.style.borderColor = '#6366f1';
                        this.style.boxShadow = '0 0 40px -5px rgba(0,0,0,.3), 0 0 20px -5px rgba(0,0,0,.15), 0 0 0 4px rgba(99,102,241,0.1)';
                    });
                    rmSearch.addEventListener('blur', function () {
                        this.style.borderColor = '';
                        this.style.boxShadow = '';
                    });
                }

                // 2. Customers Search
                const customerSearch = document.getElementById('customerSearch');
                const customerNoResults = document.getElementById('customerNoResults');
                const customerRows = document.querySelectorAll('.customer-row');
                const customerTable = document.getElementById('customerTableView');

                if (customerSearch) {
                    customerSearch.addEventListener('input', function (e) {
                        const term = e.target.value.toLowerCase().trim();
                        let count = 0;
                        customerRows.forEach(row => {
                            const cells = row.querySelectorAll('td');
                            const name = cells[0].textContent.toLowerCase();
                            const category = cells[1].textContent.toLowerCase();
                            const mobile = cells[2].textContent.toLowerCase();
                            const address = cells[3].textContent.toLowerCase();

                            const matches = name.includes(term) ||
                                category.includes(term) ||
                                mobile.includes(term) ||
                                address.includes(term);

                            row.style.display = matches ? '' : 'none';
                            if (matches) count++;
                        });

