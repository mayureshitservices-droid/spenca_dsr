        <%- include('../partials/fab', { user, userRole, hideDefaults: true, extraFabItems: [ { label: 'Stock' ,
            icon: 'box' , onClick: "showSection('stock-section')" }, { label: 'Inward History' , icon: 'clipboard-list'
            , onClick: "showSection('inward-section')" }, { label: 'Dispatch History' , icon: 'truck' ,
            onClick: "showSection('dispatch-section')" }, { label: 'Suppliers' , icon: 'users' ,
            onClick: "showSection('suppliers-section')" }, { label: 'Customers' , icon: 'user-check' ,
            onClick: "showSection('customers-section')" }, { label: 'Dashboard' , icon: 'layout-dashboard' ,
            onClick: "window.location.href='/headoffice/dashboard'" } ] }) %>
            <%- include('../partials/footer') %>

                <script>
                    function showSection(sectionId) {
                        const sections = ['stock-section', 'suppliers-section', 'customers-section', 'inward-section', 'dispatch-section'];

                        // Close FAB menu first
                        const fabBackdrop = document.getElementById('fabBackdrop');
                        if (fabBackdrop && !fabBackdrop.classList.contains('invisible')) {
                            fabBackdrop.click();
                        }

                        sections.forEach(id => {
                            const el = document.getElementById(id);
                            if (el) {
                                if (id === sectionId) {
                                    el.classList.remove('hidden');
                                    // Update hash without triggering reload
                                    history.replaceState(null, null, '#' + id);
                                    setTimeout(() => {
                                        el.scrollIntoView({ behavior: 'smooth' });
                                    }, 50);
                                } else {
                                    el.classList.add('hidden');
                                }
                            }
                        });
                    }

                    function openAddSupplierModal() {
                        const modal = document.getElementById('addSupplierModal');
                        if (modal) {
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                            document.body.style.overflow = 'hidden';
                        }
                    }

                    function openAddCustomerModal() {
                        const modal = document.getElementById('addCustomerModal');
                        if (modal) {
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                            document.body.style.overflow = 'hidden';
                        }
                    }

                    function closeAddCustomerModal() {
                        const modal = document.getElementById('addCustomerModal');
                        if (modal) {
                            modal.classList.remove('flex');
                            modal.classList.add('hidden');
                            document.body.style.overflow = '';
                        }
                    }

                    function closeAddSupplierModal() {
                        const modal = document.getElementById('addSupplierModal');
                        if (modal) {
                            modal.classList.remove('flex');
                            modal.classList.add('hidden');
                            document.body.style.overflow = '';
                        }
                    }

                    // Handle view persistence via hash
                    document.addEventListener('DOMContentLoaded', function () {
                        lucide.createIcons();

                        const hash = window.location.hash.substring(1);
                        const validSections = ['stock-section', 'suppliers-section', 'customers-section', 'inward-section', 'dispatch-section'];

                        if (hash && validSections.includes(hash)) {
                            showSection(hash);
                        } else {
                            showSection('stock-section');
                        }
                    });
                </script>