<%- include('partials/header') %>

    <div class="min-h-screen flex items-center justify-center p-4 bg-gray-100">
        <div class="w-full max-auto max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden transition-all">
            <div class="p-8 sm:p-12">
                <div class="text-center mb-10">
                    <div class="inline-flex items-center justify-center p-4 bg-primary-50 rounded-2xl mb-6">
                        <i data-lucide="droplet" class="w-10 h-10 text-primary-600 fill-primary-600"></i>
                    </div>
                    <h1 class="text-3xl font-black text-black tracking-tight mb-2 uppercase">SPENCA</h1>
                    <p class="text-gray-500 font-bold uppercase tracking-widest text-xs">Mineral Water</p>
                </div>


                <form action="/login" method="POST" class="space-y-6">
                    <div>
                        <label for="email" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wider">
                            Email Address
                        </label>
                        <div class="relative group">
                            <div
                                class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none transition-colors group-focus-within:text-primary-600 text-gray-400">
                                <i data-lucide="mail" class="w-4 h-4"></i>
                            </div>
                            <input type="email" id="email" name="email" class="input-field pl-11"
                                placeholder="name@example.com" required autofocus>
                        </div>
                    </div>

                    <div>
                        <label for="password"
                            class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wider">
                            Password
                        </label>
                        <div class="relative group">
                            <div
                                class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none transition-colors group-focus-within:text-primary-600 text-gray-400">
                                <i data-lucide="lock" class="w-4 h-4"></i>
                            </div>
                            <input type="password" id="password" name="password" class="input-field pl-11"
                                placeholder="••••••••" required>
                        </div>
                    </div>

                    <div class="pt-2">
                        <button type="submit" class="w-full btn-primary">
                            <i data-lucide="log-in" class="w-5 h-5"></i>
                            Sign In
                        </button>
                    </div>

                    <% if (error) { %>
                        <div
                            class="mt-8 p-6 bg-red-100 border-l-8 border-red-600 text-red-900 rounded-xl shadow-md animate-in fade-in slide-in-from-bottom-4 duration-500">
                            <div class="flex items-start gap-4">
                                <i data-lucide="alert-octagon" class="w-8 h-8 text-red-600 shrink-0"></i>
                                <div class="space-y-1">
                                    <p class="text-sm font-black uppercase tracking-widest text-red-600">Access Denied
                                    </p>
                                    <p class="font-bold text-lg leading-tight">
                                        <%= error %>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <% } %>
                </form>

                <div class="mt-10 pt-8 border-t border-gray-100 text-center space-y-4">
                    <!-- Custom PWA Install Button (Hidden by default) -->
                    <div id="pwa-install-container" class="hidden animate-bounce">
                        <button id="pwa-install-btn"
                            class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 text-white rounded-2xl font-black text-sm uppercase tracking-widest hover:bg-emerald-700 transition-all shadow-lg">
                            <i data-lucide="download" class="w-4 h-4"></i>
                            Install Spenca App
                        </button>
                    </div>

                    <p class="text-gray-400 text-sm flex items-center justify-center gap-2">
                        <i data-lucide="shield-check" class="w-4 h-4"></i>
                        Enterprise Secure Access Only
                    </p>
                    <p class="text-gray-400 text-sm flex items-center justify-center gap-2">
                        <i data-lucide="shield-check" class="w-4 h-4"></i>
                        System Admin : 7385556980
                    </p>
                </div>

                <script>
                    const pwaInstallContainer = document.getElementById('pwa-install-container');
                    const pwaInstallBtn = document.getElementById('pwa-install-btn');

                    function showInstallButton() {
                        // Only show if the prompt is available AND we're not already in standalone mode
                        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;

                        if (window.pwaDeferredPrompt && !isStandalone) {
                            console.log('PWA: Showing install button');
                            pwaInstallContainer.classList.remove('hidden');
                            pwaInstallContainer.classList.add('flex', 'justify-center');
                        }
                    }

                    // Check immediately
                    showInstallButton();

                    // Listen for event if it hasn't fired yet
                    window.addEventListener('pwa-prompt-ready', showInstallButton);

                    pwaInstallBtn.addEventListener('click', async () => {
                        if (!window.pwaDeferredPrompt) return;

                        // Show the prompt
                        window.pwaDeferredPrompt.prompt();

                        // Wait for the user to respond to the prompt
                        const { outcome } = await window.pwaDeferredPrompt.userChoice;
                        console.log(`PWA: User response to install prompt: ${outcome}`);

                        // We've used the prompt, and can't use it again
                        window.pwaDeferredPrompt = null;
                        pwaInstallContainer.classList.add('hidden');
                        pwaInstallContainer.classList.remove('flex');
                    });
                </script>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>