<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user, userRole }) %>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

            <!-- Header Section -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
                <div class="space-y-2">
                    <h1 class="text-4xl font-black text-black tracking-tight uppercase leading-none">
                        Inward
                    </h1>
                </div>

                <a href="/factory-incharge/inward/new" class="btn-primary w-full md:w-auto px-8">
                    Record New Inward
                </a>
            </div>

            <!-- Search Bar -->
            <div class="mb-8">
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                        <i data-lucide="search"
                            class="w-5 h-5 text-gray-400 group-focus-within:text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-500 transition-colors"></i>
                    </div>
                    <input type="text" id="inwardSearch" placeholder="Search by supplier, product, or invoice..."
                        style="padding-left: 3.75rem; padding-right: 1.5rem; padding-top: 1.25rem; padding-bottom: 1.25rem;"
                        class="w-full bg-white/95 backdrop-blur-md border border-gray-200 rounded-2xl text-sm font-bold text-gray-900 placeholder-gray-400 outline-none shadow-around-lg transition-all" />
                </div>
            </div>

            <!-- Transactions Grid -->
            <% if (inwardTransactions.length===0) { %>
                <div
                    class="bg-white/95 backdrop-blur-md rounded-3xl p-20 text-center shadow-around-lg border border-gray-100">
                    <div class="flex flex-col items-center gap-6">
                        <div
                            class="w-20 h-20 rounded-full bg-gray-50 flex items-center justify-center border border-gray-100">
                        </div>
                        <div class="space-y-2">
                            <h3 class="text-xl font-black text-gray-900 uppercase tracking-widest">No Activity Recorded
                            </h3>
                            <p class="text-sm font-medium text-gray-400">Your material history will appear here.</p>
                        </div>
                    </div>
                </div>
                <% } else { %>
                    <!-- Mobile View (Cards) -->
                    <div id="inwardCardsView" class="grid grid-cols-1 md:hidden gap-6">
                        <% inwardTransactions.forEach(item=> { %>
                            <div
                                class="inward-card glass-card p-6 flex flex-col group transition-all hover:shadow-2xl hover:-translate-y-2">
                                <!-- Top Meta: Just the Date -->
                                <div class="mb-6 pb-4 border-b border-gray-50 flex justify-between items-center">
                                    <p class="text-sm font-black text-gray-900">
                                        <%= new Date(item.createdAt).toLocaleDateString('en-IN', { day: '2-digit' ,
                                            month: 'short' , year: 'numeric' }) %>
                                    </p>
                                    <span class="text-[9px] font-black text-gray-400 uppercase tracking-tighter">
                                        <%= new Date(item.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit' ,
                                            minute: '2-digit' }) %>
                                    </span>
                                </div>

                                <!-- Main Content -->
                                <div class="space-y-6 flex-grow">
                                    <!-- Supplier -->
                                    <p
                                        class="text-base font-black text-gray-900 uppercase group-hover:text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 transition-colors tracking-tight leading-none">
                                        <%= item.supplierName %>
                                    </p>
                                </div>

                                <% if (item.invoiceNo) { %>
                                    <div class="flex items-center justify-between pt-4 border-t border-gray-50">
                                        <div class="leading-tight">
                                            <label
                                                class="block text-[8px] font-black text-gray-400 uppercase tracking-[0.2em] mb-0.5">Invoice</label>
                                            <p class="text-[10px] font-black text-gray-900 uppercase">#<%=
                                                    item.invoiceNo %>
                                                    <span class="text-gray-400 mx-1">|</span>
                                                    <%= item.invoiceDate ? new
                                                        Date(item.invoiceDate).toLocaleDateString('en-IN', {
                                                        day: '2-digit' , month: 'short' }) : 'N/A' %>
                                            </p>
                                        </div>
                                        <% if (item.invoicePhoto) { %>
                                            <a href="<%= item.invoicePhoto %>" target="_blank"
                                                class="flex items-center gap-1 text-[10px] font-black text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 hover:text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-700 uppercase tracking-tight">
                                                <i data-lucide="image" class="w-3 h-3"></i>
                                                View Photo
                                            </a>
                                            <% } %>
                                    </div>
                                    <% } %>

                                        <!-- Material & Quantity in Same Row -->
                                        <div
                                            class="flex items-start justify-between gap-4 pt-6 border-t border-gray-50">
                                            <div class="leading-tight">
                                                <label
                                                    class="block text-[8px] font-black text-gray-400 uppercase tracking-[0.2em] mb-0.5">Material</label>
                                                <p class="text-base font-black text-gray-900 uppercase leading-none">
                                                    <%= item.productName %>
                                                </p>
                                                <p
                                                    class="text-[10px] font-bold text-gray-400 uppercase tracking-tighter mt-1">
                                                    <%= item.productId ? item.productId.packaging : '' %>
                                                </p>
                                            </div>

                                            <div class="text-right">
                                                <label
                                                    class="block text-[8px] font-black text-gray-400 uppercase tracking-[0.2em] mb-0.5">Qty</label>
                                                <div class="flex flex-col items-end">
                                                    <div class="flex items-baseline justify-end gap-1">
                                                        <span class="text-xl font-black text-black leading-none">
                                                            <%= (item.quantity || 0).toFixed(0) %>
                                                        </span>
                                                        <span class="text-[10px] font-bold text-gray-400 uppercase">
                                                            <%= item.productId ? item.productId.uom : '' %>
                                                        </span>
                                                    </div>
                                                    <% if (item.inwardWeight) { %>
                                                        <span
                                                            class="text-[10px] font-black text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 uppercase mt-1">
                                                            <%= item.inwardWeight %> KG
                                                        </span>
                                                        <% } %>
                                                </div>
                                                <% if (item.inwardUnit && item.inwardUnit !== 'nos' && item.inwardUnit !== 'kg') { %>
                                                    <p class="text-[9px] font-black text-primary-600 uppercase mt-1">
                                                        Entry: <%= item.inwardQty %>
                                                        <% if (item.productName && item.productName.toLowerCase().includes('cap') && (item.inwardUnit === 'bags' || item.inwardUnit === 'boxes')) { %>
                                                            boxes
                                                        <% } else { %>
                                                            <%= item.inwardUnit %>
                                                        <% } %>
                                                    </p>
                                                <% } %>
                                            </div>
                                        </div>
                            </div>
                            <% }) %>
                    </div>

                    <!-- Desktop View (Table) -->
                    <div id="inwardTableView"
                        class="hidden md:block overflow-x-auto shadow-around-lg rounded-3xl bg-white/95 backdrop-blur-md border border-gray-100">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50/50 border-b border-gray-100">
                                    <th
                                        class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">
                                        Date</th>
                                    <th
                                        class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">
                                        Supplier</th>
                                    <th
                                        class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">
                                        Material</th>
                                    <th
                                        class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">
                                        Invoice</th>
                                    <th
                                        class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-right">
                                        Qty (Nos)</th>
                                    <th
                                        class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-right">
                                        Weight (KG)</th>

                                    <th
                                        class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] text-center">
                                        Entry Info</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <% inwardTransactions.forEach(item=> { %>
                                    <tr class="inward-row hover:bg-gray-50/50 transition-colors group">
                                        <td class="px-8 py-6">
                                            <p class="text-sm font-black text-gray-900 leading-tight">
                                                <%= new Date(item.createdAt).toLocaleDateString('en-IN', {
                                                    day: '2-digit' , month: 'short' , year: 'numeric' }) %>
                                            </p>
                                            <span
                                                class="text-[9px] font-black text-gray-400 uppercase tracking-tighter">
                                                <%= new Date(item.createdAt).toLocaleTimeString('en-IN', {
                                                    hour: '2-digit' , minute: '2-digit' }) %>
                                            </span>
                                        </td>
                                        <td class="px-8 py-6">
                                            <p class="text-sm font-black text-gray-900 uppercase tracking-tight">
                                                <%= item.supplierName %>
                                            </p>
                                        </td>
                                        <td class="px-8 py-6">
                                            <p class="text-sm font-black text-gray-900 uppercase tracking-tight">
                                                <%= item.productName %>
                                            </p>
                                            <p class="text-[10px] font-bold text-gray-400 uppercase mt-0.5">
                                                <%= item.productId ? item.productId.packaging : '' %>
                                            </p>
                                        </td>
                                        <td class="px-8 py-6">
                                            <% if (item.invoiceNo) { %>
                                                <div class="flex items-center gap-3">
                                                    <div>
                                                        <p
                                                            class="text-[10px] font-black text-gray-900 uppercase tracking-tight">
                                                            #<%= item.invoiceNo %>
                                                        </p>
                                                        <p class="text-[9px] font-bold text-gray-400 uppercase mt-0.5">
                                                            <%= item.invoiceDate ? new
                                                                Date(item.invoiceDate).toLocaleDateString('en-IN', {
                                                                day: '2-digit' , month: 'short' }) : 'N/A' %>
                                                        </p>
                                                    </div>
                                                    <% if (item.invoicePhoto) { %>
                                                        <a href="<%= item.invoicePhoto %>" target="_blank"
                                                            class="text-primary-600 hover:text-primary-700 transition-colors">
                                                            <i data-lucide="image" class="w-4 h-4"></i>
                                                        </a>
                                                        <% } %>
                                                </div>
                                                <% } else { %>
                                                    <span
                                                        class="text-[10px] font-bold text-gray-300 uppercase italic">No
                                                        Invoice</span>
                                                    <% } %>
                                        </td>
                                        <td class="px-8 py-6 text-right">
                                            <div class="flex items-baseline justify-end gap-1">
                                                <span class="text-lg font-black text-gray-900">
                                                    <%= (item.quantity || 0).toFixed(0) %>
                                                </span>
                                                <span class="text-[10px] font-bold text-gray-400 uppercase">
                                                    <%= item.productId ? item.productId.uom : '' %>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="px-8 py-6 text-right font-black text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600">
                                            <%= item.inwardWeight ? item.inwardWeight + ' KG' : '-' %>
                                        </td>

                                        <td class="px-8 py-6 text-center">
                                            <% if (item.inwardUnit && item.inwardUnit !== 'nos') { %>
                                                <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-50 text-primary-600 text-[10px] font-black uppercase tracking-widest border border-primary-100">
                                                    <%= item.inwardQty %>
                                                    <% if (item.productName && item.productName.toLowerCase().includes('cap') && (item.inwardUnit === 'bags' || item.inwardUnit === 'boxes')) { %>
                                                        boxes
                                                    <% } else { %>
                                                        <%= item.inwardUnit %>
                                                    <% } %>
                                                </span>
                                            <% } else { %>
                                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest px-3 py-1">Direct Nos</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <!-- No Results Message -->
                    <div id="inwardNoResults"
                        class="hidden bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                        <i data-lucide="search-x" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Matching Records</h3>
                        <p class="text-gray-500 font-medium">Try adjusting your search terms.</p>
                    </div>
                    <% } %>
        </div>

        <%- include('../partials/fab', { user, userRole }) %>
            <%- include('../partials/footer') %>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        if (typeof lucide !== 'undefined') lucide.createIcons();

                        const searchInput = document.getElementById('inwardSearch');
                        const noResults = document.getElementById('inwardNoResults');
                        const cardElements = document.querySelectorAll('.inward-card');
                        const rowElements = document.querySelectorAll('.inward-row');

                        if (searchInput) {
                            // Theme focus border
                            searchInput.addEventListener('focus', function () {
                                const themeColor = '<%= (factory === "indapur") ? "#6366f1" : "#a855f7" %>';
                                const themeShadow = '<%= (factory === "indapur") ? "rgba(99,102,241,0.1)" : "rgba(168,85,247,0.1)" %>';
                                this.style.borderColor = themeColor;
                                this.style.boxShadow = `0 0 40px -5px rgba(0,0,0,.3), 0 0 20px -5px rgba(0,0,0,.15), 0 0 0 4px ${themeShadow}`;
                            });
                            searchInput.addEventListener('blur', function () {
                                this.style.borderColor = '';
                                this.style.boxShadow = '';
                            });

                            searchInput.addEventListener('input', function (e) {
                                const searchTerm = e.target.value.toLowerCase().trim();
                                let visibleCount = 0;

                                // Filter Cards (Mobile)
                                cardElements.forEach(card => {
                                    const supplier = card.querySelector('.space-y-6 p.text-base')?.textContent.toLowerCase() || '';
                                    const product = card.querySelectorAll('.leading-tight p.text-base')[0]?.textContent.toLowerCase() || '';
                                    const details = card.textContent.toLowerCase(); // Just search all card text for invoice

                                    const matches = supplier.includes(searchTerm) || product.includes(searchTerm) || details.includes(searchTerm);
                                    card.style.display = matches ? '' : 'none';
                                    if (matches) visibleCount++;
                                });

                                // Filter Rows (Desktop)
                                rowElements.forEach(row => {
                                    const cells = row.querySelectorAll('td');
                                    const supplier = cells[1]?.textContent.toLowerCase() || '';
                                    const product = cells[2]?.textContent.toLowerCase() || '';
                                    const invoice = cells[3]?.textContent.toLowerCase() || '';

                                    const matches = supplier.includes(searchTerm) || product.includes(searchTerm) || invoice.includes(searchTerm);
                                    row.style.display = matches ? '' : 'none';
                                    if (matches && window.innerWidth >= 768) visibleCount++;
                                });

                                const isDesktop = window.innerWidth >= 768;
                                const cardsView = document.getElementById('inwardCardsView');
                                const tableView = document.getElementById('inwardTableView');

                                if (visibleCount === 0 && searchTerm !== '') {
                                    if (cardsView) cardsView.classList.add('hidden');
                                    if (tableView) tableView.classList.add('hidden');
                                    noResults.classList.remove('hidden');
                                } else {
                                    if (isDesktop) {
                                        if (tableView) tableView.classList.remove('hidden');
                                        if (cardsView) cardsView.classList.add('hidden');
                                    } else {
                                        if (cardsView) cardsView.classList.remove('hidden');
                                        if (tableView) tableView.classList.add('hidden');
                                    }
                                    noResults.classList.add('hidden');
                                }
                            });
                        }
                    });
                </script>