<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user, userRole }) %>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <!-- Header -->
            <div class="mb-12">
                <h1 class="text-4xl font-black text-gray-900 uppercase tracking-tight mb-2">Factory Control Hub</h1>
                <p class="text-xs font-black text-gray-400 uppercase tracking-[0.3em]">Management & Operations</p>
            </div>

            <!-- Quick Action Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

                <!-- Action: Record Inward -->
                <a href="/factory-incharge/inward/new"
                    class="group relative bg-white rounded-[2.5rem] p-8 shadow-around-lg border border-gray-100 transition-all hover:shadow-2xl hover:-translate-y-2 overflow-hidden">
                    <div class="absolute top-0 right-0 p-6 opacity-5 group-hover:opacity-10 transition-opacity">
                        <i data-lucide="download" class="w-32 h-32"></i>
                    </div>
                    <div
                        class="w-14 h-14 rounded-3xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-6 group-hover:bg-emerald-600 group-hover:text-white transition-all">
                        <i data-lucide="download" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-black text-gray-900 uppercase mb-2">Record Inward</h3>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest leading-relaxed">Log
                        incoming raw materials & supplies</p>
                </a>

                <!-- Action: Record Production -->
                <a href="/factory-incharge/production/new"
                    class="group relative bg-white rounded-[2.5rem] p-8 shadow-around-lg border border-gray-100 transition-all hover:shadow-2xl hover:-translate-y-2 overflow-hidden">
                    <div class="absolute top-0 right-0 p-6 opacity-5 group-hover:opacity-10 transition-opacity">
                        <i data-lucide="factory" class="w-32 h-32"></i>
                    </div>
                    <div
                        class="w-14 h-14 rounded-3xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-6 group-hover:bg-indigo-600 group-hover:text-white transition-all">
                        <i data-lucide="factory" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-black text-gray-900 uppercase mb-2">Record Production</h3>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest leading-relaxed">Register
                        manufactured batches</p>
                </a>

                <!-- Action: Record Dispatch -->
                <a href="/factory-incharge/dispatch/new"
                    class="group relative bg-white rounded-[2.5rem] p-8 shadow-around-lg border border-gray-100 transition-all hover:shadow-2xl hover:-translate-y-2 overflow-hidden">
                    <div class="absolute top-0 right-0 p-6 opacity-5 group-hover:opacity-10 transition-opacity">
                        <i data-lucide="upload" class="w-32 h-32"></i>
                    </div>
                    <div
                        class="w-14 h-14 rounded-3xl bg-blue-50 text-blue-600 flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-all">
                        <i data-lucide="upload" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-black text-gray-900 uppercase mb-2">Record Dispatch</h3>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest leading-relaxed">Ship
                        finished goods to customers</p>
                </a>

                <!-- Action: View Stock -->
                <a href="/factory-incharge/stock/raw-materials"
                    class="group relative bg-white rounded-[2.5rem] p-8 shadow-around-lg border border-gray-100 transition-all hover:shadow-2xl hover:-translate-y-2 overflow-hidden">
                    <div class="absolute top-0 right-0 p-6 opacity-5 group-hover:opacity-10 transition-opacity">
                        <i data-lucide="package-search" class="w-32 h-32"></i>
                    </div>
                    <div
                        class="w-14 h-14 rounded-3xl bg-amber-50 text-amber-600 flex items-center justify-center mb-6 group-hover:bg-amber-600 group-hover:text-white transition-all">
                        <i data-lucide="package-search" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-black text-gray-900 uppercase mb-2">Stock Inventory</h3>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest leading-relaxed">Check
                        current inventory levels</p>
                </a>

            </div>

            <!-- Secondary Actions -->
            <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
                <a href="/factory-incharge/inward"
                    class="glass-card p-6 flex items-center gap-4 hover:bg-gray-50 transition-colors">
                    <i data-lucide="history" class="w-5 h-5 text-gray-400"></i>
                    <span class="text-xs font-black uppercase tracking-widest text-gray-600">Inward Records</span>
                </a>

                <a href="/factory-incharge/production"
                    class="bg-white/80 backdrop-blur border border-gray-100 p-4 rounded-2xl shadow-around-sm hover:shadow-around-lg hover:-translate-y-1 transition-all flex flex-col items-center justify-center gap-3 group">
                    <div class="p-3 bg-purple-50 text-purple-600 rounded-xl group-hover:scale-110 transition-transform">
                        <i data-lucide="factory" class="w-6 h-6"></i>
                    </div>
                    <span class="text-xs font-black uppercase tracking-widest text-gray-600">Production Records</span>
                </a>

                <a href="/factory-incharge/dispatch"
                    class="bg-white/80 backdrop-blur border border-gray-100 p-4 rounded-2xl shadow-around-sm hover:shadow-around-lg hover:-translate-y-1 transition-all flex flex-col items-center justify-center gap-3 group md:col-span-2 lg:col-span-1">
                    <div class="p-3 bg-amber-50 text-amber-600 rounded-xl group-hover:scale-110 transition-transform">
                        <i data-lucide="truck" class="w-6 h-6"></i>
                    </div>
                    <span class="text-xs font-black uppercase tracking-widest text-gray-600">Dispatch Records</span>
                </a>
            </div>
        </div>

        <%- include('../partials/fab', { user, userRole }) %>
            <%- include('../partials/footer') %>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    });
                </script>