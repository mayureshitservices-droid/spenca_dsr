<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user, userRole }) %>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <!-- Header -->
            <div class="flex items-center gap-6 mb-12">
                <a href="/factory-incharge/stock/raw-materials"
                    class="w-12 h-12 rounded-full bg-white border border-gray-100 shadow-lg flex items-center justify-center text-black hover:bg-gray-50 transition-all active:scale-95 group">
                    <i data-lucide="arrow-left" class="w-6 h-6 group-hover:-translate-x-1 transition-transform"></i>
                </a>
                <div class="space-y-1">
                    <h1 class="text-3xl font-black text-black tracking-tight uppercase leading-none"><%= factory.charAt(0).toUpperCase() + factory.slice(1) %> - Finished Goods</h1>
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] ml-1">Current Inventory
                        Levels</p>
                </div>
            </div>

            <!-- Search Bar -->
            <div class="mb-8">
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                        <i data-lucide="search"
                            class="w-5 h-5 text-gray-400 group-focus-within:text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-500 transition-colors"></i>
                    </div>
                    <input type="text" id="fgSearch" placeholder="Search by product name or packaging..."
                        style="padding-left: 3.75rem; padding-right: 1.5rem; padding-top: 1.25rem; padding-bottom: 1.25rem;"
                        class="w-full bg-white/95 backdrop-blur-md border border-gray-200 rounded-2xl text-sm font-bold text-gray-900 placeholder-gray-400 outline-none shadow-around-lg transition-all" />
                </div>
            </div>

            <% if (!locals.finishedGoods || finishedGoods.length===0) { %>
                <div class="bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                    <i data-lucide="package" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">No Finished Goods</h3>
                    <p class="text-gray-500 font-medium">Ensure products are categorized as "Finished Good" in the
                        system.</p>
                </div>
                <% } else { %>
                    <!-- Mobile View (Cards) -->
                    <div id="fgCardsView" class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:hidden">
                        <% finishedGoods.forEach(function(product) { %>
                                <div
                                    class="fg-card bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg overflow-hidden border border-white/20 transition-all hover:shadow-2xl hover:-translate-y-2 group flex flex-col h-full border-t-4 border-t-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-500">
                                    <div class="p-6 flex flex-col flex-grow">
                                        <div class="flex justify-between items-start mb-4">
                                            <div class="flex-1">
                                                <h5
                                                    class="text-xl font-black text-gray-900 leading-none tracking-tight uppercase">
                                                    <%= product.productName %>
                                                </h5>
                                                <p
                                                    class="text-[10px] font-black text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 uppercase tracking-widest mt-2">
                                                    <%= product.packaging %>
                                                </p>
                                            </div>
                                            <span
                                                class="text-[10px] font-black px-2 py-1 bg-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-50 text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 rounded-lg uppercase">FG</span>
                                        </div>

                                        <div class="grid grid-cols-2 gap-3 mt-auto">
                                            <div class="bg-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-50/30 rounded-xl p-3 border border-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-100/50">
                                                <span
                                                    class="block text-[10px] font-black text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 uppercase tracking-widest mb-1">Available</span>
                                                <span class="text-2xl font-black text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-700">
                                                    <%= (product.factoryStockValue || 0).toFixed(0) %>
                                                </span>
                                                <span class="text-[10px] font-bold text-gray-400 uppercase ml-1">
                                                    <%= product.uom %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                    </div>

                    <!-- Desktop View (Table) -->
                    <div id="fgTableView"
                        class="hidden md:block overflow-x-auto shadow-around-lg rounded-3xl bg-white/95 backdrop-blur-md border border-gray-100">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50/50 border-b border-gray-100">
                                    <th
                                        class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">
                                        Product Name</th>
                                    <th
                                        class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">
                                        Packaging</th>
                                    <th
                                        class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] text-right">
                                        Available Boxes</th>
                                    <th
                                        class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] text-center">
                                        Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <% finishedGoods.forEach(function(product) { %>
                                        <tr class="fg-row hover:bg-gray-50/50 transition-colors group">
                                            <td class="px-8 py-6">
                                                <p class="text-sm font-black text-gray-900 uppercase tracking-tight">
                                                    <%= product.productName %>
                                                </p>
                                            </td>
                                            <td class="px-8 py-6">
                                                <p
                                                    class="text-[10px] font-bold text-gray-400 uppercase tracking-widest leading-relaxed">
                                                    <%= product.packaging %>
                                                </p>
                                            </td>
                                            <td class="px-8 py-6 text-right">
                                                <div class="flex items-baseline justify-end gap-1">
                                                    <span class="text-lg font-black text-gray-900">
                                                        <%= (product.factoryStockValue || 0).toFixed(0) %>
                                                    </span>
                                                    <span class="text-[10px] font-bold text-gray-400 uppercase">
                                                        <%= product.uom %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="px-8 py-6 text-center">
                                                <span
                                                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-50 text-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 text-[10px] font-black uppercase tracking-widest border border-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-100">
                                                    <i data-lucide="check-circle" class="w-3 h-3"></i>
                                                    Healthy
                                                </span>
                                            </td>
                                        </tr>
                                        <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <!-- No Results Message -->
                    <div id="fgNoResults"
                        class="hidden bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center">
                        <i data-lucide="search-x" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">No Matching Products</h3>
                        <p class="text-gray-500 font-medium">Try adjusting your search terms.</p>
                    </div>
                    <% } %>
        </div>

        <%- include('../partials/fab', { user, userRole }) %>
            <%- include('../partials/footer') %>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        if (typeof lucide !== 'undefined') lucide.createIcons();

                        const searchInput = document.getElementById('fgSearch');
                        const noResults = document.getElementById('fgNoResults');
                        const cardElements = document.querySelectorAll('.fg-card');
                        const rowElements = document.querySelectorAll('.fg-row');

                        if (searchInput) {
                            // Theme focus border
                            searchInput.addEventListener('focus', function () {
                                const themeColor = '<%= (factory === "indapur") ? "#6366f1" : "#a855f7" %>';
                                const themeShadow = '<%= (factory === "indapur") ? "rgba(99,102,241,0.1)" : "rgba(168,85,247,0.1)" %>';
                                this.style.borderColor = themeColor;
                                this.style.boxShadow = `0 0 40px -5px rgba(0,0,0,.3), 0 0 20px -5px rgba(0,0,0,.15), 0 0 0 4px ${themeShadow}`;
                            });
                            searchInput.addEventListener('blur', function () {
                                this.style.borderColor = '';
                                this.style.boxShadow = '';
                            });

                            searchInput.addEventListener('input', function (e) {
                                const searchTerm = e.target.value.toLowerCase().trim();
                                let visibleCount = 0;

                                // Filter Cards (Mobile)
                                cardElements.forEach(card => {
                                    const productName = card.querySelector('h5')?.textContent.toLowerCase() || '';
                                    const packaging = card.querySelector('.text-<%= factory === "indapur" ? "indigo" : "purple" %>-600')?.textContent.toLowerCase() || '';

                                    const matches = productName.includes(searchTerm) || packaging.includes(searchTerm);
                                    card.style.display = matches ? '' : 'none';
                                    if (matches) visibleCount++;
                                });

                                // Filter Rows (Desktop)
                                rowElements.forEach(row => {
                                    const cells = row.querySelectorAll('td');
                                    const productName = cells[0]?.textContent.toLowerCase() || '';
                                    const packaging = cells[1]?.textContent.toLowerCase() || '';

                                    const matches = productName.includes(searchTerm) || packaging.includes(searchTerm);
                                    row.style.display = matches ? '' : 'none';
                                    if (matches && window.innerWidth >= 768) visibleCount++;
                                });

                                const isDesktop = window.innerWidth >= 768;
                                const cardsView = document.getElementById('fgCardsView');
                                const tableView = document.getElementById('fgTableView');

                                if (visibleCount === 0 && searchTerm !== '') {
                                    if (cardsView) cardsView.classList.add('hidden');
                                    if (tableView) tableView.classList.add('hidden');
                                    noResults.classList.remove('hidden');
                                } else {
                                    if (isDesktop) {
                                        if (tableView) tableView.classList.remove('hidden');
                                        if (cardsView) cardsView.classList.add('hidden');
                                    } else {
                                        if (cardsView) cardsView.classList.remove('hidden');
                                        if (tableView) tableView.classList.add('hidden');
                                    }
                                    noResults.classList.add('hidden');
                                }
                            });
                        }
                    });
                </script>