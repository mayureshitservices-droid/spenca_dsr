<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delivery Challan - #<%= dispatch.dcNo %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        @media print {
            @page {
                size: A4;
                margin: 0;
            }
            body { margin: 1cm; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
            .no-print { display: none; }
        }
        .challan-yellow { background-color: #FFF9C4; } /* Mimics the yellow paper */
    </style>
</head>
<body class="bg-gray-100 min-h-screen p-4 md:p-8">

    <div class="max-w-[210mm] mx-auto bg-[#FFFDE7] shadow-2xl overflow-hidden print:shadow-none print:mt-0 p-8 border border-gray-200">
        
        <!-- Header Section -->
        <div class="flex justify-between items-start border-b-2 border-black pb-6 mb-6">
            <div class="space-y-1">
                <h1 class="text-2xl font-black text-black tracking-tight uppercase">PANCHARATNA FOUNDATION</h1>
                <p class="text-[10px] font-bold text-gray-700">Cat No. 245/8/A/2/A At post, Shirpur-So., Tal. Mohol, Dist. Solapur 413213.</p>
                <p class="text-[10px] font-bold text-gray-700">Mobile No. : 9866937633 | Email : infospenca@gmail.com | www.spenca.co.in</p>
                <p class="text-xs font-black text-black uppercase mt-2">GST No.: 27BIEPA3902N1ZD</p>
            </div>
            <div class="text-right">
                <div class="flex items-center justify-end gap-2 mb-1">
                    <div class="w-8 h-8 bg-black rounded-full flex items-center justify-center">
                        <div class="w-4 h-4 bg-white rounded-full"></div>
                    </div>
                    <span class="text-4xl font-black italic tracking-tighter">spenca</span>
                </div>
                <p class="text-[10px] font-bold italic text-gray-600">With Added Minerals</p>
            </div>
        </div>

        <!-- Title -->
        <div class="text-center mb-8">
            <h2 class="text-2xl font-black tracking-[0.2em] border-b-2 border-black inline-block px-8 py-1 uppercase italic">DELIVERY CHALLAN</h2>
        </div>

        <!-- Details Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6 mb-10">
            <!-- Left Side -->
            <div class="space-y-4">
                <div class="flex items-end gap-3 border-b border-gray-400 pb-1">
                    <span class="text-xs font-black uppercase whitespace-nowrap">Client Name :</span>
                    <span class="text-sm font-bold uppercase"><%= dispatch.receiverName %></span>
                </div>
                <div class="flex items-start gap-3 border-b border-gray-400 pb-1">
                    <span class="text-xs font-black uppercase whitespace-nowrap">Address :</span>
                    <span class="text-sm font-bold uppercase"><%= dispatch.receiverAddress || 'N/A' %></span>
                </div>
                <div class="flex items-end gap-3 border-b border-gray-400 pb-1">
                    <span class="text-xs font-black uppercase whitespace-nowrap">GSTIN :</span>
                    <span class="text-sm font-bold uppercase"><%= dispatch.receiverGSTIN || 'N/A' %></span>
                </div>
            </div>

            <!-- Right Side -->
            <div class="space-y-4">
                <div class="flex items-end gap-3 border-b border-gray-400 pb-1">
                    <span class="text-xs font-black uppercase whitespace-nowrap">Challan No :</span>
                    <span class="text-sm font-bold uppercase"><%= dispatch.dcNo %></span>
                </div>
                <div class="flex items-end gap-3 border-b border-gray-400 pb-1">
                    <span class="text-xs font-black uppercase whitespace-nowrap">Date :</span>
                    <span class="text-sm font-bold uppercase"><%= new Date(dispatch.dispatchDate).toLocaleDateString('en-IN', { day: '2-digit', month: '2-digit', year: 'numeric' }) %></span>
                </div>
                <div class="flex items-end gap-3 border-b border-gray-400 pb-1">
                    <span class="text-xs font-black uppercase whitespace-nowrap">Driver's Name :</span>
                    <span class="text-sm font-bold uppercase"><%= dispatch.driverName || 'N/A' %></span>
                </div>
                <div class="flex items-end gap-3 border-b border-gray-400 pb-1">
                    <span class="text-xs font-black uppercase whitespace-nowrap">Mobile :</span>
                    <span class="text-sm font-bold uppercase"><%= dispatch.driverMobileNo || 'N/A' %></span>
                </div>
                <div class="flex items-end gap-3 border-b border-gray-400 pb-1">
                    <span class="text-xs font-black uppercase whitespace-nowrap">Vehicle No :</span>
                    <span class="text-sm font-bold uppercase"><%= dispatch.vehicleNo || 'N/A' %></span>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div class="mb-10 border-2 border-black">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b-2 border-black">
                        <th class="border-r-2 border-black px-4 py-2 text-[10px] font-black uppercase text-center w-16">Sr.No.</th>
                        <th class="border-r-2 border-black px-4 py-2 text-[10px] font-black uppercase">Particular</th>
                        <th class="border-r-2 border-black px-4 py-2 text-[10px] font-black uppercase w-48 text-center">Batch No. & Date</th>
                        <th class="px-4 py-2 text-[10px] font-black uppercase w-32 text-center">Qty. (Box)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="border-b border-black h-12">
                        <td class="border-r-2 border-black px-4 text-center font-bold">1</td>
                        <td class="border-r-2 border-black px-4 font-black uppercase"><%= dispatch.productName %></td>
                        <td class="border-r-2 border-black px-4 text-center font-bold"><%= dispatch.batchNo || '---' %></td>
                        <td class="px-4 text-center font-black text-lg"><%= dispatch.quantity.toLocaleString() %></td>
                    </tr>
                    <!-- Empty rows to match the style -->
                    <% for(let i=2; i<=12; i++) { %>
                        <tr class="border-b border-black h-12">
                            <td class="border-r-2 border-black px-4 text-center text-gray-300"><%= i %></td>
                            <td class="border-r-2 border-black px-4"></td>
                            <td class="border-r-2 border-black px-4"></td>
                            <td></td>
                        </tr>
                    <% } %>
                    <tr class="bg-gray-50/50">
                        <td colspan="3" class="px-4 py-3 text-right font-black uppercase text-sm border-r-2 border-black">TOTAL</td>
                        <td class="px-4 py-3 text-center font-black text-xl"><%= dispatch.quantity.toLocaleString() %></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer Notice -->
        <p class="text-xs font-black italic mb-16">Received above goods in good conditions.</p>

        <!-- Signature Section -->
        <div class="flex justify-between items-end gap-12">
            <div class="text-center w-1/3 space-y-2">
                <div class="border-b border-black"></div>
                <p class="text-[10px] font-black uppercase">Receiver Signature and Stamp</p>
            </div>
            <div class="text-center w-1/3 space-y-2">
                <div class="border-b border-black"></div>
                <p class="text-[10px] font-black uppercase">Vehicle Driver Signature</p>
            </div>
            <div class="text-center w-1/3 space-y-2">
                <p class="text-[10px] font-black uppercase mb-8">For Pancharatna Foundation</p>
                <div class="border-b border-black"></div>
            </div>
        </div>

    </div>

    <!-- Print Button (Sticky) -->
    <button onclick="window.print()" class="no-print fixed bottom-8 right-8 bg-black text-white px-8 py-4 rounded-full font-black uppercase tracking-widest shadow-2xl hover:scale-105 active:scale-95 transition-all flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
        Print Challan
    </button>

</body>
</html>
