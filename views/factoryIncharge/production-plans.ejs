<%- include('../partials/header') %>
<%- include('../partials/navbar', { user, userRole }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
        <div class="space-y-2">
            <h1 class="text-4xl font-black text-black tracking-tight uppercase leading-none">
                Production Plans
            </h1>
            <p class="text-sm font-bold text-gray-400 uppercase tracking-widest">Assigned manufacturing targets</p>
        </div>
    </div>

    <!-- Alerts -->
    <% if (typeof successMessage !=='undefined' && successMessage) { %>
        <div class="mb-8 p-4 bg-emerald-500/10 border-l-4 border-emerald-500 text-emerald-800 flex items-center gap-3 rounded-r-xl backdrop-blur-md">
            <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0"></i>
            <p class="font-bold">
                <%= successMessage %>
            </p>
        </div>
    <% } %>
    <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
        <div class="mb-8 p-4 bg-red-500/10 border-l-4 border-red-500 text-red-800 flex items-center gap-3 rounded-r-xl backdrop-blur-md">
            <i data-lucide="alert-triangle" class="w-5 h-5 text-red-500 shrink-0"></i>
            <p class="font-bold">
                <%= errorMessage %>
            </p>
        </div>
    <% } %>

    <!-- Filter Bar -->
    <div class="mb-8 flex gap-4 overflow-x-auto pb-2 custom-scrollbar">
        <button onclick="filterPlans('All')" class="plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 text-white shadow-lg">All Plans</button>
        <button onclick="filterPlans('Pending')" class="plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-white hover:bg-amber-50 text-gray-600 hover:text-amber-600 shadow-sm border border-gray-100">Pending</button>
        <button onclick="filterPlans('In Progress')" class="plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-white hover:bg-blue-50 text-gray-600 hover:text-blue-600 shadow-sm border border-gray-100">In Progress</button>
        <button onclick="filterPlans('Completed')" class="plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-white hover:bg-emerald-50 text-gray-600 hover:text-emerald-600 shadow-sm border border-gray-100">Completed</button>
    </div>

    <!-- Plans Table -->
    <% if (!productionPlans || productionPlans.length === 0) { %>
        <div class="bg-white/95 backdrop-blur-md rounded-3xl p-20 text-center shadow-around-lg border border-gray-100">
            <div class="flex flex-col items-center gap-6">
                <div class="w-20 h-20 rounded-full bg-gray-50 flex items-center justify-center border border-gray-100">
                    <i data-lucide="clipboard-x" class="w-10 h-10 text-gray-300"></i>
                </div>
                <div class="space-y-2">
                    <h3 class="text-xl font-black text-gray-900 uppercase tracking-widest">No Production Plans</h3>
                    <p class="text-sm font-medium text-gray-400">There are currently no production plans assigned to this factory.</p>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg border border-white/20 overflow-hidden" id="plansGrid">
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50 border-b border-gray-100 sticky top-0 z-10 backdrop-blur-sm">
                            <th class="px-6 py-4 text-left text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Date</th>
                            <th class="px-6 py-4 text-left text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Product Name</th>
                            <th class="px-6 py-4 text-right text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Target</th>
                            <th class="px-6 py-4 text-right text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Produced</th>
                            <th class="px-6 py-4 text-center text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Status</th>
                            <th class="px-6 py-4 text-right text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100" id="plansTableBody">
                        <% productionPlans.forEach(plan => { %>
                            <% plan.targetFinishedGoods.forEach(target => { %>
                                <% 
                                    const progress = target.targetBoxes > 0 ? (target.producedBoxes / target.targetBoxes) * 100 : 0;
                                    const isComplete = target.producedBoxes >= target.targetBoxes;
                                    
                                    let statusClass = 'bg-gray-100 text-gray-600';
                                    let statusText = 'Pending';
                                    
                                    if (target.producedBoxes > 0 && target.producedBoxes < target.targetBoxes) {
                                        statusClass = 'bg-blue-100 text-blue-700 border border-blue-200';
                                        statusText = 'In Progress';
                                    } else if (isComplete) {
                                        statusClass = 'bg-emerald-100 text-emerald-700 border border-emerald-200';
                                        statusText = 'Completed';
                                    } else if (plan.status === 'Pending') {
                                        statusClass = 'bg-amber-100 text-amber-700 border border-amber-200';
                                        statusText = 'Pending';
                                    }
                                %>
                                <tr class="plan-row group hover:bg-gray-50/50 transition-colors" data-status="<%= statusText %>">
                                    <td class="px-6 py-5 whitespace-nowrap">
                                        <p class="text-sm font-black text-gray-900 leading-none">
                                            <%= new Date(plan.assignedDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                        </p>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="flex flex-col">
                                            <p class="text-sm font-black text-gray-900 uppercase">
                                                <%= target.product ? target.product.productName : 'Unknown Product' %>
                                            </p>
                                            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mt-1">
                                                <%= target.product ? target.product.packaging : '' %>
                                            </p>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 text-right whitespace-nowrap">
                                        <p class="text-sm font-black text-gray-900">
                                            <%= target.targetBoxes %> <span class="text-[9px] text-gray-400 uppercase ml-1">Box</span>
                                        </p>
                                    </td>
                                    <td class="px-6 py-5 text-right whitespace-nowrap">
                                        <div class="flex flex-col items-end">
                                            <p class="text-sm font-black <%= isComplete ? 'text-emerald-600' : 'text-gray-900' %>">
                                                <%= target.producedBoxes %> <span class="text-[9px] text-gray-400 uppercase ml-1">Box</span>
                                            </p>
                                            <div class="w-16 h-1 bg-gray-100 rounded-full mt-2 overflow-hidden">
                                                <div class="h-full <%= isComplete ? 'bg-emerald-500' : (factory === 'indapur' ? 'bg-indigo-500' : 'bg-purple-500') %>" style="width: <%= Math.min(100, progress) + '%' %>"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 text-center whitespace-nowrap">
                                        <span class="px-3 py-1 text-[9px] font-black rounded-full uppercase tracking-widest shadow-sm <%= statusClass %>">
                                            <%= statusText %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-5 text-right whitespace-nowrap">
                                        <% if (!isComplete) { %>
                                            <a href="/factory-incharge/production/new" class="inline-flex items-center gap-2 px-4 py-2 bg-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 text-white text-[10px] font-black rounded-xl uppercase tracking-widest hover:bg-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-700 transition-all shadow-md hover:shadow-lg">
                                                <i data-lucide="play-circle" class="w-3.5 h-3.5"></i> Log Production
                                            </a>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-50 text-emerald-600 text-[10px] font-black rounded-xl uppercase tracking-widest border border-emerald-100">
                                                <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Target Met
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- No Filter Results Message -->
        <div id="noFilterResults" class="hidden bg-white/95 backdrop-blur-md rounded-3xl p-20 text-center shadow-around-lg border border-gray-100 mt-6">
            <div class="flex flex-col items-center gap-6">
                <div class="w-20 h-20 rounded-full bg-gray-50 flex items-center justify-center border border-gray-100">
                    <i data-lucide="filter-x" class="w-10 h-10 text-gray-300"></i>
                </div>
                <div class="space-y-2">
                    <h3 class="text-xl font-black text-gray-900 uppercase tracking-widest">No Plans Match Filter</h3>
                    <p class="text-sm font-medium text-gray-400">Try selecting a different status filter.</p>
                </div>
            </div>
        </div>
    <% } %>
</div>

<%- include('../partials/fab', { user, userRole }) %>
<%- include('../partials/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });

    function filterPlans(status) {
        // Update Buttons
        const themeColorClass = '<%= factory === "indapur" ? "bg-indigo-600" : "bg-purple-600" %>';
        const buttons = document.querySelectorAll('.plan-filter-btn');
        
        buttons.forEach(btn => {
            if (btn.textContent.trim() === status || (status === 'All' && btn.textContent.trim() === 'All Plans')) {
                btn.className = `plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all ${themeColorClass} text-white shadow-lg`;
            } else {
                let hoverColor = 'hover:text-gray-900';
                let hoverBg = 'hover:bg-gray-100';
                if (btn.textContent.trim() === 'Pending') { hoverColor = 'hover:text-amber-600'; hoverBg = 'hover:bg-amber-50'; }
                if (btn.textContent.trim() === 'In Progress') { hoverColor = 'hover:text-blue-600'; hoverBg = 'hover:bg-blue-50'; }
                if (btn.textContent.trim() === 'Completed') { hoverColor = 'hover:text-emerald-600'; hoverBg = 'hover:bg-emerald-50'; }
                
                btn.className = `plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-white text-gray-600 shadow-sm border border-gray-100 ${hoverBg} ${hoverColor}`;
            }
        });

        // Filter Rows
        const rows = document.querySelectorAll('.plan-row');
        let visibleCount = 0;
        
        rows.forEach(row => {
            const rowStatus = row.getAttribute('data-status');
            if (status === 'All' || rowStatus === status) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // Show/Hide No Results
        const noResults = document.getElementById('noFilterResults');
        const tableGrid = document.getElementById('plansGrid');
        
        if (noResults && tableGrid) {
            if (visibleCount === 0) {
                noResults.classList.remove('hidden');
                tableGrid.classList.add('hidden');
            } else {
                noResults.classList.add('hidden');
                tableGrid.classList.remove('hidden');
            }
        }
    }
</script>
