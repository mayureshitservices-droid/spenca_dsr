<%- include('../partials/header') %>
<%- include('../partials/navbar', { user, userRole }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
        <div class="space-y-2">
            <h1 class="text-4xl font-black text-black tracking-tight uppercase leading-none">
                Production Plans
            </h1>
            <p class="text-sm font-bold text-gray-400 uppercase tracking-widest">Assigned manufacturing targets</p>
        </div>
    </div>

    <!-- Alerts -->
    <% if (typeof successMessage !=='undefined' && successMessage) { %>
        <div class="mb-8 p-4 bg-emerald-500/10 border-l-4 border-emerald-500 text-emerald-800 flex items-center gap-3 rounded-r-xl backdrop-blur-md">
            <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500 shrink-0"></i>
            <p class="font-bold">
                <%= successMessage %>
            </p>
        </div>
    <% } %>
    <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
        <div class="mb-8 p-4 bg-red-500/10 border-l-4 border-red-500 text-red-800 flex items-center gap-3 rounded-r-xl backdrop-blur-md">
            <i data-lucide="alert-triangle" class="w-5 h-5 text-red-500 shrink-0"></i>
            <p class="font-bold">
                <%= errorMessage %>
            </p>
        </div>
    <% } %>

    <!-- Filter Bar -->
    <div class="mb-8 flex gap-4 overflow-x-auto pb-2 custom-scrollbar">
        <button onclick="filterPlans('All')" class="plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 text-white shadow-lg">All Plans</button>
        <button onclick="filterPlans('Pending')" class="plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-white hover:bg-amber-50 text-gray-600 hover:text-amber-600 shadow-sm border border-gray-100">Pending</button>
        <button onclick="filterPlans('In Progress')" class="plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-white hover:bg-blue-50 text-gray-600 hover:text-blue-600 shadow-sm border border-gray-100">In Progress</button>
        <button onclick="filterPlans('Completed')" class="plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-white hover:bg-emerald-50 text-gray-600 hover:text-emerald-600 shadow-sm border border-gray-100">Completed</button>
    </div>

    <!-- Plans Grid -->
    <% if (!productionPlans || productionPlans.length === 0) { %>
        <div class="bg-white/95 backdrop-blur-md rounded-3xl p-20 text-center shadow-around-lg border border-gray-100">
            <div class="flex flex-col items-center gap-6">
                <div class="w-20 h-20 rounded-full bg-gray-50 flex items-center justify-center border border-gray-100">
                    <i data-lucide="clipboard-x" class="w-10 h-10 text-gray-300"></i>
                </div>
                <div class="space-y-2">
                    <h3 class="text-xl font-black text-gray-900 uppercase tracking-widest">No Production Plans</h3>
                    <p class="text-sm font-medium text-gray-400">There are currently no production plans assigned to this factory.</p>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="plansGrid">
            <% productionPlans.forEach(plan => { %>
                <div class="plan-card glass-card p-6 flex flex-col group transition-all hover:shadow-2xl hover:-translate-y-1 relative overflow-hidden bg-white/95 backdrop-blur-md rounded-3xl shadow-around-lg border border-white/20" data-status="<%= plan.status %>">
                    
                    <!-- Top Meta -->
                    <div class="mb-5 pb-4 border-b border-gray-100 flex justify-between items-start">
                        <div class="flex flex-col">
                            <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Plan Date</p>
                            <p class="text-sm font-black text-gray-900">
                                <%= new Date(plan.assignedDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                            </p>
                            <p class="text-[10px] font-bold text-gray-500 mt-1">
                                Assigned by <span class="text-gray-900"><%= plan.assignedBy ? plan.assignedBy.fullName : 'System' %></span>
                            </p>
                        </div>
                        <div class="text-right flex flex-col items-end gap-2">
                            <% 
                                let statusClass = 'bg-gray-100 text-gray-600';
                                if (plan.status === 'Pending') statusClass = 'bg-amber-100 text-amber-700 border border-amber-200';
                                if (plan.status === 'In Progress') statusClass = 'bg-blue-100 text-blue-700 border border-blue-200';
                                if (plan.status === 'Completed') statusClass = 'bg-emerald-100 text-emerald-700 border border-emerald-200';
                            %>
                            <span class="px-3 py-1 text-[10px] font-black rounded-full uppercase tracking-widest shadow-sm <%= statusClass %>">
                                <%= plan.status %>
                            </span>
                        </div>
                    </div>

                    <!-- Targets -->
                    <div class="flex-grow">
                        <h4 class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] mb-4">Target Finished Goods</h4>
                        <div class="space-y-3">
                            <% plan.targetFinishedGoods.forEach(target => { %>
                                <% 
                                    const progress = target.targetBoxes > 0 ? (target.producedBoxes / target.targetBoxes) * 100 : 0;
                                    const progressClamped = Math.min(100, Math.max(0, progress));
                                    const isComplete = target.producedBoxes >= target.targetBoxes;
                                %>
                                <div class="p-4 bg-gray-50/50 rounded-2xl border border-gray-100 relative overflow-hidden group/item hover:bg-white transition-colors">
                                    <div class="absolute bottom-0 left-0 h-1 bg-gray-100 w-full">
                                        <div class="h-full transition-all duration-1000 <%= isComplete ? 'bg-emerald-500' : (factory === 'indapur' ? 'bg-indigo-500' : 'bg-purple-500') %>" style="width: <%= progressClamped %>%"></div>
                                    </div>
                                    
                                    <div class="relative z-10 flex justify-between items-start mb-2">
                                        <div class="pr-4">
                                            <p class="text-sm font-black text-gray-900 uppercase leading-snug">
                                                <%= target.product ? target.product.productName : 'Unknown Product' %>
                                            </p>
                                            <p class="text-[9px] font-bold text-gray-400 uppercase mt-0.5">
                                                <%= target.product ? target.product.packaging : '' %>
                                            </p>
                                        </div>
                                        <div class="text-right shrink-0">
                                            <div class="text-[10px] font-black uppercase tracking-widest mb-1 text-gray-400">Target</div>
                                            <div class="text-lg font-black text-gray-900 leading-none"><%= target.targetBoxes %> <span class="text-[9px] text-gray-400 uppercase">box</span></div>
                                        </div>
                                    </div>
                                    
                                    <div class="relative z-10 flex justify-between items-end mt-3 pt-3 border-t border-gray-200/50">
                                        <div>
                                            <div class="text-[9px] font-black uppercase tracking-widest mb-1 text-gray-400">Produced</div>
                                            <div class="text-sm font-black <%= isComplete ? 'text-emerald-600' : 'text-indigo-600' %>">
                                                <%= target.producedBoxes %> <span class="text-[9px] opacity-70 uppercase">box</span>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-[10px] font-black <%= isComplete ? 'text-emerald-500' : 'text-gray-500' %>">
                                                <%= progressClamped.toFixed(0) %>%
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Action Area -->
                    <div class="mt-6 pt-5 border-t border-gray-100 flex justify-between items-center">
                        <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                            <%= plan.targetFinishedGoods.length %> Product(s)
                        </div>
                        <% if (plan.status !== 'Completed') { %>
                            <a href="/factory-incharge/production/new" class="text-[11px] font-black text-white bg-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-600 hover:bg-<%= factory === 'indapur' ? 'indigo' : 'purple' %>-700 px-4 py-2 rounded-lg uppercase tracking-widest transition-colors shadow-md flex items-center gap-2">
                                <i data-lucide="play-circle" class="w-3.5 h-3.5"></i> Log Production
                            </a>
                        <% } else { %>
                            <span class="text-[11px] font-black text-emerald-600 bg-emerald-50 px-4 py-2 rounded-lg uppercase tracking-widest flex items-center gap-2 border border-emerald-100">
                                <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Target Met
                            </span>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- No Filter Results Message -->
        <div id="noFilterResults" class="hidden bg-gray-50/50 border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center mt-6">
            <i data-lucide="filter-x" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
            <h3 class="text-xl font-bold text-gray-900 mb-2">No Plans Match Filter</h3>
            <p class="text-gray-500 font-medium text-sm">Try selecting a different status filter.</p>
        </div>
    <% } %>
</div>

<%- include('../partials/fab', { user, userRole }) %>
<%- include('../partials/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });

    function filterPlans(status) {
        // Update Buttons
        const themeColorClass = '<%= factory === "indapur" ? "bg-indigo-600" : "bg-purple-600" %>';
        const buttons = document.querySelectorAll('.plan-filter-btn');
        
        buttons.forEach(btn => {
            if (btn.textContent.trim() === status || (status === 'All' && btn.textContent.trim() === 'All Plans')) {
                btn.className = `plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all ${themeColorClass} text-white shadow-lg`;
            } else {
                let hoverColor = 'hover:text-gray-900';
                let hoverBg = 'hover:bg-gray-100';
                if (btn.textContent.trim() === 'Pending') { hoverColor = 'hover:text-amber-600'; hoverBg = 'hover:bg-amber-50'; }
                if (btn.textContent.trim() === 'In Progress') { hoverColor = 'hover:text-blue-600'; hoverBg = 'hover:bg-blue-50'; }
                if (btn.textContent.trim() === 'Completed') { hoverColor = 'hover:text-emerald-600'; hoverBg = 'hover:bg-emerald-50'; }
                
                btn.className = `plan-filter-btn px-6 py-2.5 rounded-xl text-sm font-black uppercase tracking-widest transition-all bg-white text-gray-600 shadow-sm border border-gray-100 ${hoverBg} ${hoverColor}`;
            }
        });

        // Filter Cards
        const cards = document.querySelectorAll('.plan-card');
        let visibleCount = 0;
        
        cards.forEach(card => {
            const cardStatus = card.getAttribute('data-status');
            if (status === 'All' || cardStatus === status) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        // Show/Hide No Results
        const noResults = document.getElementById('noFilterResults');
        const grid = document.getElementById('plansGrid');
        
        if (noResults && grid) {
            if (visibleCount === 0) {
                noResults.classList.remove('hidden');
                grid.classList.add('hidden');
            } else {
                noResults.classList.add('hidden');
                grid.classList.remove('hidden');
            }
        }
    }
</script>
