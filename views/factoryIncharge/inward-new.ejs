<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user, userRole }) %>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

            <!-- Header -->
            <div class="flex items-center gap-6 mb-12">
                <a href="/factory-incharge/inward"
                    class="w-12 h-12 rounded-full bg-white border border-gray-100 shadow-lg flex items-center justify-center text-black hover:bg-gray-50 transition-all active:scale-95 group">
                    <i data-lucide="arrow-left" class="w-6 h-6 group-hover:-translate-x-1 transition-transform"></i>
                </a>
                <h1 class="text-3xl font-black text-black tracking-tight uppercase leading-none">Record Inward</h1>
            </div>

            <!-- Alerts -->
            <% if (typeof success !=='undefined' && success) { %>
                <div
                    class="mb-8 p-4 bg-emerald-500/10 border-l-4 border-emerald-500 text-emerald-800 flex items-center justify-between gap-3 rounded-r-xl backdrop-blur-md">
                    <div class="flex items-center gap-3">
                        <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500"></i>
                        <p class="font-bold">
                            <%= success %>
                        </p>
                    </div>
                </div>
                <% } %>

                    <% if (typeof error !=='undefined' && error) { %>
                        <div
                            class="mb-8 p-4 bg-red-500/10 border-l-4 border-red-500 text-red-800 flex items-center justify-between gap-3 rounded-r-xl backdrop-blur-md">
                            <div class="flex items-center gap-3">
                                <i data-lucide="alert-triangle" class="w-5 h-5 text-red-500"></i>
                                <p class="font-bold">
                                    <%= error %>
                                </p>
                            </div>
                        </div>
                        <% } %>

                            <div class="glass-card overflow-hidden">
                                <div class="card-header-primary">
                                    <h2 class="text-xl font-black">Entry Details</h2>
                                </div>

                                <form id="inwardForm" action="/factory-incharge/inward" method="POST"
                                    onsubmit="return collectItems()" class="p-8 space-y-8">

                                    <!-- Header Info: Supplier & Invoice -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                        <!-- Supplier Selection -->
                                        <div class="md:col-span-2 space-y-3">
                                            <label
                                                class="block text-xs font-black text-gray-500 uppercase tracking-widest ml-1">Select
                                                Supplier *</label>
                                            <div class="relative">
                                                <input type="text" id="supplierInput" required autocomplete="off"
                                                    class="input-field" placeholder="Start typing supplier name...">
                                                <input type="hidden" id="selectedSupplierId" name="supplierId">
                                                <div class="absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden z-[100] hidden"
                                                    id="supplierSuggestions"></div>
                                            </div>
                                        </div>

                                        <div class="space-y-3">
                                            <label
                                                class="block text-xs font-black text-gray-500 uppercase tracking-widest ml-1">Invoice
                                                No</label>
                                            <div class="relative">
                                                <input type="text" name="invoiceNo" class="input-field"
                                                    placeholder="INV/2024/001">
                                            </div>
                                        </div>

                                        <div class="space-y-3">
                                            <label
                                                class="block text-xs font-black text-gray-500 uppercase tracking-widest ml-1">Invoice
                                                Date</label>
                                            <div class="relative">
                                                <input type="date" name="invoiceDate" class="input-field">
                                            </div>
                                        </div>
                                    </div>

                                    <hr class="border-gray-100">

                                    <!-- Items Section -->
                                    <div class="space-y-6">
                                        <div class="flex items-center justify-between">
                                            <h3 class="text-sm font-black uppercase tracking-widest text-gray-400">
                                                Material Items</h3>
                                        </div>

                                        <div id="itemsContainer" class="space-y-6">
                                            <!-- Item Row Template -->
                                            <div class="group relative bg-gray-50/50 p-6 rounded-3xl border-2 border-dashed border-gray-200"
                                                id="itemRow_1">
                                                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
                                                    <!-- Material Selection -->
                                                    <div class="md:col-span-5 space-y-2">
                                                        <label
                                                            class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Select
                                                            Material *</label>
                                                        <div class="relative">
                                                            <input type="text" id="materialInput_1" required
                                                                autocomplete="off" class="input-field shadow-sm"
                                                                placeholder="Start typing material name...">
                                                            <input type="hidden" id="selectedProductId_1"
                                                                class="item-product-id">
                                                            <div class="absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden z-[100] hidden"
                                                                id="materialSuggestions_1"></div>
                                                        </div>
                                                    </div>

                                                    <!-- Quantity -->
                                                    <div class="md:col-span-2 space-y-2">
                                                        <label
                                                            class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Qty
                                                            *</label>
                                                        <input type="number" step="0.01" id="quantity_1" required
                                                            class="input-field shadow-sm item-quantity"
                                                            placeholder="0.00">
                                                    </div>

                                                    <!-- Price -->
                                                    <div class="md:col-span-2 space-y-2">
                                                        <label
                                                            class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Price
                                                            *</label>
                                                        <input type="number" step="0.01" id="price_1" required
                                                            class="input-field shadow-sm item-price" placeholder="0.00">
                                                    </div>

                                                    <!-- GST -->
                                                    <div class="md:col-span-2 space-y-2">
                                                        <label
                                                            class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">GST
                                                            %</label>
                                                        <select id="gstPercentage_1" required
                                                            class="input-field shadow-sm item-gst">
                                                            <option value="0">0%</option>
                                                            <option value="5">5%</option>
                                                            <option value="12">12%</option>
                                                            <option value="18" selected>18%</option>
                                                            <option value="28">28%</option>
                                                        </select>
                                                    </div>

                                                    <!-- Actions -->
                                                    <div class="md:col-span-1">
                                                        <button type="button" onclick="removeItemRow(1)"
                                                            class="w-full p-3.5 text-gray-300 hover:text-red-500 transition-colors bg-transparent rounded-2xl">
                                                            <i data-lucide="trash-2" class="w-5 h-5 mx-auto"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <button type="button" onclick="addItemRow()"
                                            class="w-full py-4 border-2 border-dashed border-primary-300 text-black font-black rounded-3xl hover:bg-primary-50 hover:border-primary-400 transition-all flex items-center justify-center gap-3 active:scale-95">
                                            <i data-lucide="plus-circle" class="w-5 h-5"></i>
                                            Add Another Material
                                        </button>
                                    </div>

                                    <!-- Hidden field for collected items -->
                                    <input type="hidden" name="items" id="itemsData">

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                        <!-- Condition Confirmation -->
                                        <div class="md:col-span-2 pt-6">
                                            <label class="flex items-start gap-4 cursor-pointer group">
                                                <div class="relative flex items-center justify-center shrink-0 mt-1">
                                                    <input type="checkbox" name="conditionConfirmed" required
                                                        class="peer h-6 w-6 cursor-pointer appearance-none rounded-lg border-2 border-gray-200 bg-gray-50 checked:bg-primary-600 checked:border-primary-600 transition-all">
                                                    <i data-lucide="check"
                                                        class="absolute h-4 w-4 text-white opacity-0 peer-checked:opacity-100 transition-opacity pointer-events-none stroke-[4]"></i>
                                                </div>
                                                <div class="space-y-0.5">
                                                    <span
                                                        class="text-sm font-black text-gray-900 group-hover:text-primary-600 transition-colors">I
                                                        confirm material condition is OK *</span>
                                                    <p class="text-xs font-bold text-gray-400">Material has been
                                                        verified for quantity and quality standards.</p>
                                                </div>
                                            </label>
                                        </div>

                                        <!-- Submit -->
                                        <div class="md:col-span-2 pt-6">
                                            <button type="submit" class="btn-primary w-full py-5 text-lg">
                                                submit
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
        </div>


        <%- include('../partials/footer') %>

            <script src="/js/autocomplete.js"></script>
            <script>
                let rowCount = 1;

                function addItemRow() {
                    rowCount++;
                    const container = document.getElementById('itemsContainer');
                    const row = document.createElement('div');
                    row.className = 'group relative bg-gray-50/50 p-6 rounded-3xl border-2 border-dashed border-gray-200 animate-in slide-in-from-top-4 duration-300';
                    row.id = `itemRow_${rowCount}`;

                    row.innerHTML = `
                            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
                                <div class="md:col-span-5 space-y-2">
                                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Select Material *</label>
                                    <div class="relative">
                                        <input type="text" id="materialInput_${rowCount}" required autocomplete="off"
                                            class="input-field shadow-sm" placeholder="Start typing material name...">
                                        <input type="hidden" id="selectedProductId_${rowCount}" class="item-product-id">
                                        <div class="absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden z-[100] hidden"
                                            id="materialSuggestions_${rowCount}"></div>
                                    </div>
                                </div>
                                <div class="md:col-span-2 space-y-2">
                                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Qty *</label>
                                    <input type="number" step="0.01" id="quantity_${rowCount}" required
                                        class="input-field shadow-sm item-quantity" placeholder="0.00">
                                </div>
                                <div class="md:col-span-2 space-y-2">
                                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Price *</label>
                                    <input type="number" step="0.01" id="price_${rowCount}" required
                                        class="input-field shadow-sm item-price" placeholder="0.00">
                                </div>
                                <div class="md:col-span-2 space-y-2">
                                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">GST %</label>
                                    <select id="gstPercentage_${rowCount}" required class="input-field shadow-sm item-gst">
                                        <option value="0">0%</option>
                                        <option value="5">5%</option>
                                        <option value="12">12%</option>
                                        <option value="18" selected>18%</option>
                                        <option value="28">28%</option>
                                    </select>
                                </div>
                                <div class="md:col-span-1">
                                    <button type="button" onclick="removeItemRow(${rowCount})" class="w-full p-3.5 text-gray-300 hover:text-red-500 transition-colors bg-transparent rounded-2xl">
                                        <i data-lucide="trash-2" class="w-5 h-5 mx-auto"></i>
                                    </button>
                                </div>
                            </div>
                        `;

                    container.appendChild(row);
                    lucide.createIcons();
                    initMaterialAutocomplete(rowCount);
                }

                function removeItemRow(id) {
                    const rows = document.querySelectorAll('[id^="itemRow_"]');
                    if (rows.length > 1) {
                        const row = document.getElementById(`itemRow_${id}`);
                        row.classList.add('animate-out', 'fade-out', 'zoom-out', 'duration-200');
                        setTimeout(() => row.remove(), 200);
                    } else {
                        alert('At least one item is required');
                    }
                }

                function initMaterialAutocomplete(id) {
                    setupAutocomplete({
                        input: document.getElementById(`materialInput_${id}`),
                        suggestions: document.getElementById(`materialSuggestions_${id}`),
                        hiddenInput: document.getElementById(`selectedProductId_${id}`),
                        url: '/api/raw-materials/search',
                        formatResult: (item) => `
                                <div class="p-4 hover:bg-gray-50 cursor-pointer border-b border-gray-50 last:border-0 transition-colors">
                                    <div class="font-black text-gray-900 uppercase text-xs">${item.productName}</div>
                                    <div class="text-[10px] font-bold text-gray-400 uppercase mt-0.5">${item.packaging} | ${item.uom}</div>
                                </div>
                            `,
                        onSelect: (item) => {
                            document.getElementById(`materialInput_${id}`).value = item.productName;
                        }
                    });
                }

                function collectItems() {
                    const items = [];
                    const rows = document.querySelectorAll('[id^="itemRow_"]');
                    let isValid = true;

                    rows.forEach(row => {
                        const id = row.id.split('_')[1];
                        const productId = document.getElementById(`selectedProductId_${id}`).value;
                        const quantity = document.getElementById(`quantity_${id}`).value;
                        const price = document.getElementById(`price_${id}`).value;
                        const gstPercentage = document.getElementById(`gstPercentage_${id}`).value;

                        if (!productId || !quantity || !price) {
                            isValid = false;
                            row.classList.add('border-red-200', 'bg-red-50/30');
                            setTimeout(() => row.classList.remove('border-red-200', 'bg-red-50/30'), 2000);
                        } else {
                            items.push({
                                productId,
                                quantity,
                                price,
                                gstPercentage
                            });
                        }
                    });

                    if (!isValid) {
                        alert('Please fill all required fields for each item and select materials from the suggestions.');
                        return false;
                    }

                    document.getElementById('itemsData').value = JSON.stringify(items);
                    return true;
                }

                document.addEventListener('DOMContentLoaded', () => {
                    lucide.createIcons();

                    // Initialize Supplier Autocomplete
                    setupAutocomplete({
                        input: document.getElementById('supplierInput'),
                        suggestions: document.getElementById('supplierSuggestions'),
                        hiddenInput: document.getElementById('selectedSupplierId'),
                        url: '/api/suppliers/search',
                        formatResult: (item) => `
                                <div class="p-4 hover:bg-gray-50 cursor-pointer border-b border-gray-50 last:border-0 transition-colors">
                                    <div class="font-black text-gray-900 uppercase text-xs">${item.supplierName}</div>
                                    <div class="text-[10px] font-bold text-gray-400">GST: ${item.gstNo || 'N/A'}</div>
                                </div>
                            `,
                        onSelect: (item) => {
                            document.getElementById('supplierInput').value = item.supplierName;
                        }
                    });

                    // Initialize First Material Row
                    initMaterialAutocomplete(1);
                });
            </script>